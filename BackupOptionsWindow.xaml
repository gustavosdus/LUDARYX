<Window x:Class="UnifiedGameLauncher.BackupOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup" Width="520" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0D0F14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="EXPORTAR BACKUP" Foreground="White" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="DescriptionText" Text="Escolha quais categorias deseja incluir." Foreground="#9BA3B4" Margin="0,5,0,18"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <CheckBox x:Name="SettingsCheck" IsChecked="True" Content="Configurações, favoritos, ocultos, estatísticas e jogos manuais" Foreground="#D9DDE7" Margin="0,8"/>
            <CheckBox x:Name="ArtworkCheck" IsChecked="True" Content="Artes personalizadas" Foreground="#D9DDE7" Margin="0,8"/>
            <CheckBox x:Name="MetadataCheck" IsChecked="True" Content="Cache de metadados (sem cache automático de capas)" Foreground="#D9DDE7" Margin="0,8"/>
            <TextBlock x:Name="EstimatedSizeText" Foreground="#9BA3B4" Margin="0,14,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCELAR" Width="110" Margin="4" Click="Cancel_Click"/>
            <Button x:Name="ContinueButton" Content="CONTINUAR" Width="120" Margin="4" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>