<Window x:Class="UnifiedGameLauncher.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sobre / Créditos" Width="760" Height="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource LudaryxWindowBackground}"
        Foreground="{DynamicResource LudaryxTextPrimary}"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource LudaryxTitleBarBackground}"
                BorderBrush="{DynamicResource LudaryxTitleBarBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource LudaryxRed}" Margin="0,0,9,0"/>
                    <TextBlock Text="LUDARYX"
                               Foreground="{DynamicResource LudaryxTextPrimary}"
                               FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="  /  Sobre / Créditos"
                               Foreground="{DynamicResource LudaryxTitleBarSecondaryText}"
                               FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="—" Click="MinimizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="□" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="×" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="LUDARYX" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="28" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource LudaryxTextSecondary}" Margin="0,4,0,18"/>

                <TextBlock Text="Sobre" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource LudaryxTextPrimary}" TextWrapping="Wrap" Margin="0,6,0,16"
                           Text="LUDARYX é um launcher independente para organizar e iniciar jogos instalados no computador. Não é afiliado, patrocinado ou endossado pelas plataformas, lojas, editoras ou desenvolvedoras mencionadas no aplicativo."/>

                <TextBlock Text="Desenvolvimento com auxílio de IA" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource LudaryxTextPrimary}" TextWrapping="Wrap" Margin="0,6,0,6"
                           Text="O LUDARYX foi desenvolvido com o auxílio de ferramentas de inteligência artificial, incluindo o ChatGPT, em tarefas como geração e revisão de código, correção de erros, documentação, refinamento da interface e organização do projeto."/>
                <TextBlock Foreground="{DynamicResource LudaryxTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="A direção do projeto, as decisões de funcionalidades, os testes, a validação das builds e a responsabilidade final pelo software permanecem com o mantenedor do projeto."/>

                <TextBlock Text="Fontes de dados" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource LudaryxTextPrimary}" TextWrapping="Wrap" Margin="0,6,0,6"
                           Text="Metadados podem ser obtidos de Steam, GOG, Wikidata, Wikipedia, PCGamingWiki e IGDB, conforme disponibilidade e configuração. Capas podem ser obtidas da Steam e SteamGridDB. A fonte efetivamente usada em cada jogo é exibida na tela de detalhes."/>
                <TextBlock Foreground="{DynamicResource LudaryxTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="Marcas, nomes de produtos, capas, artes e textos de terceiros pertencem aos seus respectivos titulares. O LUDARYX não incorpora bibliotecas de capas baixadas no instalador; conteúdo externo é obtido no computador do usuário quando necessário."/>

                <TextBlock Text="Licenças e atribuições" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource LudaryxTextPrimary}" TextWrapping="Wrap" Margin="0,6,0,6"
                           Text="Wikidata: dados estruturados sob CC0. Wikipedia: texto normalmente sob CC BY-SA. PCGamingWiki: conteúdo sob CC BY-NC-SA, salvo indicação diferente; o LUDARYX limita essa integração a dados estruturados/factuais. As dependências de software e seus avisos estão listados em THIRD-PARTY-NOTICES.txt."/>
                <TextBlock Foreground="{DynamicResource LudaryxTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="Para distribuição comercial futura, revise novamente as licenças e os termos das fontes de dados antes do lançamento."/>

                <TextBlock Text="Privacidade" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource LudaryxTextPrimary}" TextWrapping="Wrap" Margin="0,6,0,16"
                           Text="Esta versão não possui telemetria própria nem envia sua biblioteca para um servidor do LUDARYX. Para buscar capas e metadados, consultas são enviadas diretamente às fontes externas configuradas. Detalhes adicionais estão em PRIVACY.md."/>

                <TextBlock Text="Diagnóstico" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="DiagnosticsText" Foreground="{DynamicResource LudaryxTextPrimary}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="ABRIR PASTA DE LOGS" Padding="12,6" Margin="0,0,8,0" Click="OpenLogs_Click"/>
                    <Button Content="COPIAR DIAGNÓSTICO" Padding="12,6" Margin="0,0,8,0" Click="CopyDiagnostics_Click"/>
                    <Button Content="VERIFICAR ATUALIZAÇÕES" Padding="12,6" Click="CheckUpdates_Click"/>
                </StackPanel>

                <TextBlock Text="Arquivos incluídos" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource LudaryxTextPrimary}" TextWrapping="Wrap" Margin="0,6,0,6"
                           Text="THIRD-PARTY-NOTICES.txt — bibliotecas e licenças&#x0a;DATA-SOURCES.md — fontes de metadados e regras de uso&#x0a;PRIVACY.md — comportamento de privacidade&#x0a;LEGAL-NOTICE.md — marcas, conteúdo de terceiros e limitações&#x0a;Docs/AI-ASSISTANCE.md — transparência sobre o uso de inteligência artificial no desenvolvimento"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="FECHAR" Width="110" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
