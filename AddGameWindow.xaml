<Window x:Class="UnifiedGameLauncher.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar jogo" Width="720" Height="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0D1119">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="ADICIONAR JOGO MANUALMENTE" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Nome" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <TextBox x:Name="NameBox" Height="36" Padding="8"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Perfil de inicialização" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="NOVO PERFIL" Width="110" Margin="8,0,0,0" Click="NewProfile_Click"/>
                    <Button Content="EXCLUIR PERFIL" Width="120" Margin="8,0,0,0" Click="DeleteProfile_Click"/>
                </StackPanel>
                <ComboBox x:Name="ProfileCombo" Height="36" SelectionChanged="ProfileCombo_SelectionChanged"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Nome do perfil" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <TextBox x:Name="ProfileNameBox" Height="36" Padding="8"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Executável (.exe)" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <DockPanel>
                <Button Content="PROCURAR" Width="95" DockPanel.Dock="Right" Click="BrowseExe_Click"/>
                <TextBox x:Name="ExeBox" Height="36" Padding="8"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <TextBlock Text="Argumentos de inicialização (opcional)" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <TextBox x:Name="ArgumentsBox" Height="36" Padding="8"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,12">
            <TextBlock Text="URI de inicialização (opcional)" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <TextBox x:Name="UriBox" Height="36" Padding="8"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,0,0,12">
            <TextBlock Text="Pasta de trabalho (opcional)" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <DockPanel>
                <Button Content="PROCURAR" Width="95" DockPanel.Dock="Right" Click="BrowseWorkingDirectory_Click"/>
                <TextBox x:Name="WorkingDirectoryBox" Height="36" Padding="8"/>
            </DockPanel>
        </StackPanel>

        <CheckBox x:Name="RunAsAdministratorCheck" Grid.Row="8" Content="Executar como administrador" Foreground="#D9DDE7" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="9" Margin="0,0,0,12">
            <TextBlock Text="Ícone personalizado (opcional)" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <DockPanel>
                <Button Content="PROCURAR" Width="95" DockPanel.Dock="Right" Click="BrowseIcon_Click"/>
                <TextBox x:Name="IconPathBox" Height="36" Padding="8" IsReadOnly="True"/>
            </DockPanel>
        </StackPanel>

        <TextBlock Grid.Row="10"
                   Text="Crie perfis diferentes para iniciar o mesmo jogo com argumentos distintos, por exemplo Normal, Sem mods ou Modo janela. O perfil selecionado será usado ao jogar."
                   Foreground="#7F8AA3" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="CANCELAR" Width="110" Margin="4" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="ADICIONAR" Width="120" Margin="4" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>