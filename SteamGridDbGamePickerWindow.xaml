<Window x:Class="UnifiedGameLauncher.SteamGridDbGamePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Escolher jogo no SteamGridDB" Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource LudaryxWindowBackground}"
        Foreground="{DynamicResource LudaryxTextPrimary}"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource LudaryxTitleBarBackground}"
                BorderBrush="{DynamicResource LudaryxTitleBarBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource LudaryxRed}" Margin="0,0,9,0"/>
                    <TextBlock Text="LUDARYX"
                               Foreground="{DynamicResource LudaryxTextPrimary}"
                               FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="  /  SteamGridDB / Jogo"
                               Foreground="{DynamicResource LudaryxTitleBarSecondaryText}"
                               FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="—" Click="MinimizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="□" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="×" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ESCOLHER JOGO DO STEAMGRIDDB" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="24" FontWeight="Bold"/>
        <DockPanel Grid.Row="1" Margin="0,14,0,12">
            <Button DockPanel.Dock="Right" Content="PESQUISAR" Width="120" Click="Search_Click"/>
            <TextBox x:Name="SearchBox" Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="ResultsList" Grid.Row="2" Background="{DynamicResource LudaryxListBackground}" BorderThickness="0" Foreground="{DynamicResource LudaryxTextPrimary}" MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource LudaryxItemBackground}" CornerRadius="8" Padding="12" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource LudaryxTextPrimary}"/>
                                <TextBlock Text="{Binding Id, StringFormat=ID: {0}}" Foreground="{DynamicResource LudaryxTextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="VERIFICADO" Foreground="{DynamicResource LudaryxBadgeForeground}" VerticalAlignment="Center" Visibility="{Binding Verified, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="CANCELAR" Width="110" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="USAR SELECIONADO" Width="150" Click="Use_Click"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
