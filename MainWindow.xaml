<Window x:Class="UnifiedGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:services="clr-namespace:UnifiedGameLauncher.Services"
        Title="LUDARYX" Icon="pack://application:,,,/Assets/LUDARYX.ico" Width="1400" Height="900"
        WindowStartupLocation="CenterScreen" Background="#05070B"
        WindowStyle="None" ResizeMode="CanResize"
        MinWidth="1100" MinHeight="650"
        KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown"
        SnapsToDevicePixels="True" SizeChanged="MainWindow_SizeChanged">

    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <services:CoverImageConverter x:Key="CoverImageConverter"/>

        <!-- Paleta principal -->
        <SolidColorBrush x:Key="BlackChrome" Color="#050507"/>
        <SolidColorBrush x:Key="BlackPanel" Color="#090A0D"/>
        <SolidColorBrush x:Key="GameAreaBlue" Color="#07182D"/>
        <SolidColorBrush x:Key="NeonRed" Color="#FF163D"/>
        <SolidColorBrush x:Key="NeonBlue" Color="#66F5FF"/>
        <SolidColorBrush x:Key="SelectionAccentBorder" Color="#66F5FF"/>
        <SolidColorBrush x:Key="SelectionAccentGameFill" Color="#13DFFF"/>

        <!-- Recursos que mudam com o tema. Mantidos centralizados para facilitar edição manual. -->
        <SolidColorBrush x:Key="ToolbarFieldBackground" Color="#050507"/>
        <SolidColorBrush x:Key="SearchFieldBackground" Color="#11151D"/>
        <SolidColorBrush x:Key="NavButtonBackground" Color="#11151D"/>
        <SolidColorBrush x:Key="NavButtonHoverBackground" Color="#1A202B"/>
        <SolidColorBrush x:Key="NavButtonPressedBackground" Color="#252D3A"/>
        <SolidColorBrush x:Key="ToolbarFieldHoverBackground" Color="#0A0D12"/>
        <SolidColorBrush x:Key="ToolbarPopupBackground" Color="#050507"/>
        <SolidColorBrush x:Key="ToolbarItemHoverBackground" Color="#111A26"/>
        <SolidColorBrush x:Key="ToolbarItemSelectedBackground" Color="#10283D"/>
        <SolidColorBrush x:Key="SearchCaretBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SelectedPanelBackground" Color="#0A1421"/>
        <SolidColorBrush x:Key="SelectedPanelBorder" Color="#1E3850"/>
        <SolidColorBrush x:Key="SelectedPanelArtworkBackground" Color="#07111C"/>
        <SolidColorBrush x:Key="SelectedPanelArtworkBorder" Color="#1C344C"/>
        <SolidColorBrush x:Key="SelectedPanelTextPrimary" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="SelectedPanelTextSecondary" Color="#9AAABD"/>
        <SolidColorBrush x:Key="SelectedPanelMeta" Color="#82D8FF"/>
        <SolidColorBrush x:Key="SelectedPanelDivider" Color="#1B3147"/>
        <SolidColorBrush x:Key="TvHeroBackground" Color="#07111D"/>
        <SolidColorBrush x:Key="TvHeroTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TvHeroTextSecondary" Color="#A9B6C7"/>
        <SolidColorBrush x:Key="TvHeroMeta" Color="#9EDBFF"/>
        <SolidColorBrush x:Key="TvHeroDescription" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="TvHeroPreviewBackground" Color="#33101C29"/>
        <SolidColorBrush x:Key="TvHeroPreviewBorder" Color="#31506D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8E98AA"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#202938"/>
        <SolidColorBrush x:Key="LaunchOverlayBackdrop" Color="#D9020509"/>
        <SolidColorBrush x:Key="LaunchOverlayPanel" Color="#F20A111B"/>
        <SolidColorBrush x:Key="LaunchOverlayBorder" Color="#31445A"/>
        <SolidColorBrush x:Key="LaunchOverlayTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LaunchOverlayTextSecondary" Color="#AAB7C8"/>
        <SolidColorBrush x:Key="LaunchOverlayArtworkBackground" Color="#07111C"/>
        <SolidColorBrush x:Key="LaunchOverlayArtworkBorder" Color="#26384C"/>
        <SolidColorBrush x:Key="LaunchProgressTrack" Color="#26313D"/>
        <SolidColorBrush x:Key="LaunchProgressNeon" Color="#FFE600"/>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE2EC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20242D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource NavButtonBackground}"/>
            <Setter Property="Foreground" Value="#E8ECF5"/>
            <Setter Property="BorderBrush" Value="#293242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.58"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavButtonHoverBackground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavButtonPressedBackground}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seletor compacto de densidade da biblioteca: três pontos para 4/5/6 jogos. -->
        <Style x:Key="LibraryDensitySlider" TargetType="Slider">
            <Setter Property="Width" Value="116"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,3,3,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" Margin="5,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="17"/>
                                <RowDefinition Height="9"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Border x:Name="DensityTrackLine"
                                        Height="2"
                                        Margin="2,0"
                                        VerticalAlignment="Center"
                                        Background="#42546A"
                                        CornerRadius="1"/>
                                <Ellipse Width="5" Height="5" HorizontalAlignment="Left"
                                         VerticalAlignment="Center" Fill="#7D91A8"/>
                                <Ellipse Width="5" Height="5" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Fill="#7D91A8"/>
                                <Ellipse Width="5" Height="5" HorizontalAlignment="Right"
                                         VerticalAlignment="Center" Fill="#7D91A8"/>
                                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="11" Height="11" Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="{DynamicResource SelectionAccentBorder}"
                                                             Stroke="#D9FBFF" StrokeThickness="1"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="4" Foreground="#8092A8"
                                           FontSize="7" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="5" Foreground="#8092A8"
                                           FontSize="7" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="6" Foreground="#8092A8"
                                           FontSize="7" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DensityTrackLine" Property="Background" Value="#607991"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DensityTrackLine" Property="Background"
                                        Value="{DynamicResource SelectionAccentBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoverModeSwitchSlider" TargetType="Slider">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,3,3,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="CoverTrackLine" Width="38" Height="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#42546A" CornerRadius="1"/>
                            <TextBlock Text="V" Foreground="#8EA1B7" FontWeight="Bold" FontSize="9"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"/>
                            <TextBlock Text="H" Foreground="#8EA1B7" FontWeight="Bold" FontSize="9"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"/>
                            <Track x:Name="PART_Track" Orientation="Horizontal"
                                   Margin="12,0" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource SelectionAccentBorder}"
                                                         Stroke="#D9FBFF" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CoverTrackLine" Property="Background" Value="#607991"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CoverTrackLine" Property="Background"
                                        Value="{DynamicResource SelectionAccentBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeSwitchSlider" TargetType="Slider">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,3,3,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="ThemeTrackLine" Width="38" Height="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#42546A" CornerRadius="1"/>
                            <TextBlock Text="☀" Foreground="#D6A94B" FontSize="13"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="☾" Foreground="#A9C9E8" FontSize="15"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Orientation="Horizontal"
                                   Margin="14,0" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource SelectionAccentBorder}"
                                                         Stroke="#D9FBFF" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeTrackLine" Property="Background" Value="#607991"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ThemeTrackLine" Property="Background"
                                        Value="{DynamicResource SelectionAccentBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="IntegratedIconButton" TargetType="Button">
            <Setter Property="Opacity" Value="0.58"/>
            <Setter Property="Foreground" Value="#E8ECF5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="FocusMark"
                                    Height="2"
                                    Margin="8,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource SelectionAccentBorder}"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter TargetName="FocusMark" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de tela cheia sem fundo: somente o ícone do monitor -->
        <Style x:Key="FullscreenIconButton" TargetType="Button">
            <Setter Property="Opacity" Value="0.50"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox totalmente integrado ao tema; não usa o template cinza padrão do Windows -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="138"/>
            <Setter Property="Foreground" Value="#E8ECF5"/>
            <Setter Property="Background" Value="{DynamicResource ToolbarFieldBackground}"/>
            <Setter Property="BorderBrush" Value="#252D3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="9,0,3,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False"/>
                                <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2"
                                              Background="Transparent" BorderThickness="0"
                                              Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" Width="8" Height="5"
                                                      Fill="#9AA6B8" Stretch="Fill"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,3,0,0" Padding="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="330" Background="{DynamicResource ToolbarPopupBackground}"
                                        BorderBrush="#252D3A" BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource ToolbarFieldHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8ECF5"/>
            <Setter Property="Background" Value="{DynamicResource ToolbarPopupBackground}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ToolbarItemHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ToolbarItemSelectedBackground}"/>
                                <Setter Property="Foreground" Value="#62D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de rolagem integrada ao tema -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#354660"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1,3,1,3">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Background="Transparent" BorderThickness="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="44" Background="#354660" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#354660" CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Background="Transparent" BorderThickness="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FooterHintChip" TargetType="Border">
            <Setter Property="Background" Value="#101923"/>
            <Setter Property="BorderBrush" Value="#34475D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Storyboard x:Key="StartupStoryboard">
            <!-- Animação de abertura com a logo transparente LUDARYX. -->
            <DoubleAnimation Storyboard.TargetName="StartupLogoHost" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.70"/>
            <DoubleAnimation Storyboard.TargetName="StartupLogoScale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1" BeginTime="0:0:0.15" Duration="0:0:0.70"/>
            <DoubleAnimation Storyboard.TargetName="StartupLogoScale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1" BeginTime="0:0:0.15" Duration="0:0:0.70"/>
            <DoubleAnimation Storyboard.TargetName="StartupGlowHalo" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.34" BeginTime="0:0:0.28" Duration="0:0:0.75"/>
            <DoubleAnimation Storyboard.TargetName="StartupAccentLine" Storyboard.TargetProperty="Width"
                             From="0" To="760" BeginTime="0:0:0.95" Duration="0:0:0.55"/>
            <DoubleAnimation Storyboard.TargetName="StartupAccentLine" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.95" Duration="0:0:0.12"/>

            <!-- Pulso principal por volta de 3,5 s. -->
            <DoubleAnimation Storyboard.TargetName="StartupLogoScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.025" AutoReverse="True" BeginTime="0:0:3.35" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="StartupLogoScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.025" AutoReverse="True" BeginTime="0:0:3.35" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="StartupGlowHalo" Storyboard.TargetProperty="Opacity"
                             From="0.34" To="0.48" AutoReverse="True" BeginTime="0:0:3.35" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="StartupAccentLine" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.60" AutoReverse="True" BeginTime="0:0:3.40" Duration="0:0:0.18"/>

            <!-- Fade-out para a biblioteca. -->
            <DoubleAnimation Storyboard.TargetName="StartupOverlay" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" BeginTime="0:0:4.5" Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="MainRoot" Background="{StaticResource BlackChrome}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="78"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="56"/>
            <RowDefinition x:Name="FilterSummaryRow" Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- Desktop header: compact identity, central search and global actions. -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Background="#05070B"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              GotKeyboardFocus="ToolbarRegion_GotKeyboardFocus">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image Source="pack://application:,,,/Assets/LUDARYX.png"
                       Width="150" Height="44" Stretch="Uniform" SnapsToDevicePixels="True"
                       HorizontalAlignment="Left"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="440" MaxWidth="520" Height="38"
                        Background="{DynamicResource SearchFieldBackground}"
                        BorderBrush="#2A3C50" BorderThickness="1" CornerRadius="7"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <TextBlock Text="⌕" Foreground="#7E9AB4" FontSize="18"
                                   VerticalAlignment="Center" Margin="11,0,0,0"/>
                        <TextBox x:Name="SearchBox" Margin="34,1,58,1"
                                 Background="Transparent" Foreground="#E8ECF5"
                                 CaretBrush="{DynamicResource SearchCaretBrush}" BorderThickness="0"
                                 Padding="0" MinHeight="0" VerticalContentAlignment="Center"
                                 FontSize="12" TextChanged="SearchBox_TextChanged"
                                 ToolTip="Buscar jogos, gêneros, plataformas, desenvolvedoras e publicadoras"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Padding="7,3" CornerRadius="4"
                                Background="#0D1724" BorderBrush="#263A50" BorderThickness="1">
                            <TextBlock Text="Ctrl+F" Foreground="#7D91A9" FontSize="9"/>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock x:Name="LibraryLoadingText" Text="CARREGANDO BIBLIOTECA..."
                           Visibility="Collapsed" Foreground="#8EBAD5"
                           FontSize="9" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button x:Name="GlobalRefreshButton" Style="{StaticResource IntegratedIconButton}"
                        Click="Refresh_Click" ToolTip="Atualizar biblioteca" Margin="0,0,5,0">
                    <Viewbox Width="17" Height="17">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#E8ECF5" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M20,11 A8,8 0 1 0 18.2,16.1 M20,5 L20,11 L14,11"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="GlobalSettingsButton" Style="{StaticResource IntegratedIconButton}" Click="Settings_Click" ToolTip="Configurações" Margin="0,0,5,0">
                    <TextBlock Text="⚙" Foreground="#E8ECF5" FontSize="17"/>
                </Button>
                <Button x:Name="GlobalStatisticsButton" Style="{StaticResource IntegratedIconButton}" Click="Statistics_Click" ToolTip="Estatísticas" Margin="0,0,5,0">
                    <TextBlock Text="▥" Foreground="#E8ECF5" FontSize="16"/>
                </Button>
                <Button x:Name="GlobalFullscreenButton" Style="{StaticResource FullscreenIconButton}" Click="Fullscreen_Click" ToolTip="Tela cheia" Margin="0,0,8,0">
                    <Viewbox Width="19" Height="19">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#E8ECF5" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Data="M3,4 L21,4 L21,17 L3,17 Z M9,21 L15,21 M12,17 L12,21"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Content="—" Style="{StaticResource WindowButton}" Click="MinimizeWindow_Click" ToolTip="Minimizar"/>
                <Button Content="□" Style="{StaticResource WindowButton}" Click="MaximizeWindow_Click" ToolTip="Maximizar"/>
                <Button Content="×" Style="{StaticResource WindowButton}" Click="CloseWindow_Click" ToolTip="Fechar"/>
            </StackPanel>
        </Grid>

        <Border x:Name="NeonSeparator" Grid.Row="1" Background="{StaticResource NeonRed}"/>

        <!-- Filters are kept separate from administrative actions. -->
        <Border x:Name="ToolbarBorder" Grid.Row="2" Background="#070A10"
                BorderBrush="#152131" BorderThickness="0,0,0,1"
                GotKeyboardFocus="ToolbarRegion_GotKeyboardFocus">
            <Grid Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="LibraryFilterCombo" Width="150" Style="{StaticResource FilterCombo}" ItemContainerStyle="{StaticResource FilterComboItem}" SelectionChanged="LibraryFilterCombo_SelectionChanged" ToolTip="Filtrar biblioteca">
                            <ComboBoxItem Content="TODOS" Tag="all"/>
                            <ComboBoxItem Content="FAVORITOS" Tag="favorites"/>
                            <ComboBoxItem Content="RECENTES" Tag="recent"/>
                            <ComboBoxItem Content="DUPLICADOS" Tag="duplicates"/>
                            <ComboBoxItem Content="OCULTOS" Tag="hidden"/>
                        </ComboBox>
                        <ComboBox x:Name="PlatformFilterCombo" Width="160" Style="{StaticResource FilterCombo}" ItemContainerStyle="{StaticResource FilterComboItem}" SelectionChanged="PlatformFilterCombo_SelectionChanged" ToolTip="Filtrar por plataforma">
                            <ComboBoxItem Content="TODAS PLATAFORMAS" Tag="all"/>
                            <ComboBoxItem Content="STEAM" Tag="Steam"/>
                            <ComboBoxItem Content="EPIC" Tag="Epic"/>
                            <ComboBoxItem Content="GOG" Tag="GOG"/>
                            <ComboBoxItem Content="XBOX / STORE" Tag="Xbox"/>
                            <ComboBoxItem Content="EA APP" Tag="EAApp"/>
                            <ComboBoxItem Content="UBISOFT" Tag="UbisoftConnect"/>
                            <ComboBoxItem Content="BATTLE.NET" Tag="BattleNet"/>
                            <ComboBoxItem Content="RIOT" Tag="RiotClient"/>
                            <ComboBoxItem Content="MANUAIS" Tag="Manual"/>
                        </ComboBox>
                        <ComboBox x:Name="GenreFilter" Width="160" Style="{StaticResource FilterCombo}" ItemContainerStyle="{StaticResource FilterComboItem}" SelectionChanged="GenreFilter_SelectionChanged" ToolTip="Filtrar por gênero"/>
                        <ComboBox x:Name="SortCombo" Width="150" Style="{StaticResource FilterCombo}" ItemContainerStyle="{StaticResource FilterComboItem}" SelectionChanged="SortCombo_SelectionChanged" ToolTip="Ordenar">
                            <ComboBoxItem Content="NOME" Tag="Name"/>
                            <ComboBoxItem Content="RECENTES" Tag="Recent"/>
                            <ComboBoxItem Content="MAIS JOGADOS" Tag="MostPlayed"/>
                            <ComboBoxItem Content="TEMPO JOGADO" Tag="PlayTime"/>
                            <ComboBoxItem Content="PLATAFORMA" Tag="Platform"/>
                        </ComboBox>

                        <Button x:Name="RefreshVisibleButton" Content="ATUALIZAR FILTRO" Style="{StaticResource NavButton}" Click="RefreshVisible_Click"/>
                        <Button x:Name="ClearFiltersButton" Content="LIMPAR" Style="{StaticResource NavButton}" Click="ClearFilters_Click"/>
                        <Button x:Name="AddGameButton" Content="+ JOGO MANUAL" Style="{StaticResource NavButton}" Click="AddGame_Click"/>
                        <Slider x:Name="LibraryColumnsSlider"
                                Style="{StaticResource LibraryDensitySlider}"
                                Minimum="4" Maximum="6" Value="6"
                                TickFrequency="1"
                                SmallChange="1" LargeChange="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="LibraryColumnsSlider_ValueChanged"
                                GotKeyboardFocus="ToolbarSlider_GotKeyboardFocus"
                                ToolTip="Jogos por linha"/>
                        <Slider x:Name="CoverModeSlider"
                                Style="{StaticResource CoverModeSwitchSlider}"
                                Minimum="0" Maximum="1" Value="1"
                                TickFrequency="1"
                                SmallChange="1" LargeChange="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="CoverModeSlider_ValueChanged"
                                GotKeyboardFocus="ToolbarSlider_GotKeyboardFocus"
                                ToolTip="Formato da capa: Vertical / Horizontal"/>
                        <Slider x:Name="ThemeSlider"
                                Style="{StaticResource ThemeSwitchSlider}"
                                Minimum="0" Maximum="1" Value="1"
                                TickFrequency="1"
                                SmallChange="1" LargeChange="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="ThemeSlider_ValueChanged"
                                GotKeyboardFocus="ToolbarSlider_GotKeyboardFocus"
                                ToolTip="Tema: Claro / Escuro"/>

                        <TextBlock x:Name="FullscreenLibraryLoadingText" Text="CARREGANDO..."
                                   Visibility="Collapsed" Foreground="#8EBAD5" FontSize="9"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,3,0"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="FullscreenSearchContainer" Visibility="Collapsed"
                            Width="300" Height="36" Margin="8,0,7,0"
                            Background="{DynamicResource SearchFieldBackground}"
                            BorderBrush="#2A3C50" BorderThickness="1" CornerRadius="7"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <TextBlock Text="⌕" Foreground="#7E9AB4" FontSize="18" VerticalAlignment="Center" Margin="11,0,0,0"/>
                            <TextBox x:Name="FullscreenSearchBox" Margin="34,1,10,1"
                                     Background="Transparent" Foreground="#E8ECF5"
                                     CaretBrush="{DynamicResource SearchCaretBrush}" BorderThickness="0"
                                     Padding="0" MinHeight="0" VerticalContentAlignment="Center"
                                     FontSize="12" TextChanged="FullscreenSearchBox_TextChanged" ToolTip="Pesquisar jogos"/>
                        </Grid>
                    </Border>
                    <Button x:Name="FullscreenRefreshButton" Visibility="Collapsed"
                            Style="{StaticResource FullscreenIconButton}" Click="Refresh_Click"
                            ToolTip="Atualizar biblioteca">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#E8ECF5" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M20,11 A8,8 0 1 0 18.2,16.1 M20,5 L20,11 L14,11"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FullscreenSettingsButton" Visibility="Collapsed"
                            Style="{StaticResource FullscreenIconButton}" Click="Settings_Click"
                            ToolTip="Configurações">
                        <TextBlock Text="⚙" Foreground="#E8ECF5" FontSize="17"/>
                    </Button>
                    <Button x:Name="FullscreenStatisticsButton" Visibility="Collapsed"
                            Style="{StaticResource FullscreenIconButton}" Click="Statistics_Click"
                            ToolTip="Estatísticas">
                        <TextBlock Text="▥" Foreground="#E8ECF5" FontSize="16"/>
                    </Button>
                    <Button x:Name="FullscreenToolbarButton" Visibility="Collapsed"
                            Style="{StaticResource FullscreenIconButton}" Click="Fullscreen_Click"
                            ToolTip="Sair da tela cheia">
                        <TextBlock Text="⛶" Foreground="#E8ECF5" FontSize="17"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active filters / context strip. -->
        <Border x:Name="FilterSummaryBorder" Grid.Row="3" Background="#070C13"
                BorderBrush="#172437" BorderThickness="0,0,0,1">
            <Grid Margin="17,3,16,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FILTROS" Foreground="#657B94" FontSize="9" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="CollectionFilterChip" Style="{StaticResource LudaryxFilterChip}"
                            Visibility="Collapsed" Click="ClearCollectionFilter_Click" Margin="0,0,6,0"/>
                    <Button x:Name="PlatformFilterChip" Style="{StaticResource LudaryxFilterChip}"
                            Visibility="Collapsed" Click="ClearPlatformFilter_Click" Margin="0,0,6,0"/>
                    <Button x:Name="GenreFilterChip" Style="{StaticResource LudaryxFilterChip}"
                            Visibility="Collapsed" Click="ClearGenreFilter_Click" Margin="0,0,6,0"/>
                    <Button x:Name="SortFilterChip" Style="{StaticResource LudaryxFilterChip}"
                            Visibility="Collapsed" Click="ResetSortFilter_Click" Margin="0,0,6,0"/>
                </StackPanel>
                <TextBlock x:Name="GameCountText" Text="0 jogos exibidos"
                           Foreground="#8DA0B7" FontSize="10"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Shared library. Desktop adds a side panel; TV adds a hero above the same grid. -->
        <Grid Grid.Row="4" Background="{StaticResource GameAreaBlue}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="FullscreenLoadingIndicator"
                  Grid.RowSpan="2"
                  Width="38"
                  Height="38"
                  Visibility="Collapsed"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="24,0,0,20"
                  Panel.ZIndex="80"
                  IsHitTestVisible="False"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="FullscreenSpinnerRotation"/>
                </Grid.RenderTransform>

                <!-- Anel fino contínuo: não existe quebra entre as duas espessuras. -->
                <Ellipse Width="30"
                         Height="30"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stroke="{Binding Background, ElementName=NeonSeparator}"
                         StrokeThickness="2"
                         Fill="Transparent"/>

                <!-- Pequeno trecho mais espesso sobre o mesmo contorno. -->
                <Path Stroke="{Binding Background, ElementName=NeonSeparator}"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Fill="Transparent"
                      Data="M19,4 A15,15 0 0 1 30.6,9.5"/>

                <Grid.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="FullscreenSpinnerRotation"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0"
                                                 To="360"
                                                 Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
            </Grid>

            <!-- TV hero. Visible only in fullscreen. -->
            <Border x:Name="TvHeroPanel" Grid.Row="0" Height="250"
                    Visibility="Collapsed" Background="{DynamicResource TvHeroBackground}"
                    GotKeyboardFocus="HeroRegion_GotKeyboardFocus"
                    BorderBrush="{DynamicResource SelectedPanelBorder}" BorderThickness="0,0,0,1"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="TvHeroArtwork" Stretch="UniformToFill" Opacity="0.34">
                        <Image.Effect><BlurEffect Radius="16"/></Image.Effect>
                    </Image>
                    <Border x:Name="TvHeroTint" Background="#B807101B"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop x:Name="TvHeroGradientStart" Color="#F0060B12" Offset="0"/>
                                <GradientStop x:Name="TvHeroGradientMiddle" Color="#D00A1420" Offset="0.55"/>
                                <GradientStop x:Name="TvHeroGradientEnd" Color="#900A1420" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid Margin="46,26,46,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Stretch" MaxWidth="760" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TvHeroTitle" Grid.Row="0" Text="LUDARYX"
                                       Foreground="{DynamicResource TvHeroTextPrimary}"
                                       FontSize="32" FontWeight="Bold" TextWrapping="Wrap"
                                       MaxHeight="76" ClipToBounds="True"/>
                            <TextBlock x:Name="TvHeroMeta" Grid.Row="1"
                                       Foreground="{DynamicResource TvHeroMeta}" FontSize="12"
                                       Margin="0,7,0,0"/>
                            <TextBlock x:Name="TvHeroUsage" Grid.Row="2"
                                       Foreground="{DynamicResource TvHeroTextSecondary}" FontSize="11"
                                       Margin="0,5,0,0"/>
                            <TextBlock x:Name="TvHeroDescription" Grid.Row="3"
                                       Foreground="{DynamicResource TvHeroDescription}"
                                       FontSize="12" TextWrapping="Wrap"
                                       MaxHeight="46" ClipToBounds="True"
                                       VerticalAlignment="Top" Margin="0,10,0,8"/>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="TvPlayButton"
                                        Style="{StaticResource LudaryxHeroPrimaryButton}"
                                        Click="SelectedPlay_Click" Margin="0,0,8,0">
                                    <TextBlock x:Name="TvPlayButtonText" Text="A  JOGAR"/>
                                </Button>
                                <Button x:Name="TvDetailsButton"
                                        Style="{StaticResource LudaryxHeroButton}"
                                        Click="SelectedDetails_Click" Margin="0,0,8,0">
                                    <TextBlock x:Name="TvDetailsButtonText" Text="X  DETALHES"/>
                                </Button>
                                <Button x:Name="TvFavoriteButton"
                                        Style="{StaticResource LudaryxHeroButton}"
                                        Click="SelectedFavorite_Click">
                                    <TextBlock x:Name="TvFavoriteButtonText" Text="Y  FAVORITO"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="TvHeroPreviewBorder" Grid.Column="1" Width="340" Height="190"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{DynamicResource TvHeroPreviewBackground}" BorderBrush="{DynamicResource TvHeroPreviewBorder}"
                                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                            <Image x:Name="TvHeroPreviewImage" Stretch="Uniform"
                                   SizeChanged="FramedArtworkImage_SizeChanged"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SelectedPanelColumn" Width="330"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="LibraryAreaBorder" Grid.Column="0" Background="{StaticResource GameAreaBlue}">
                    <Grid>
                        <ScrollViewer x:Name="LibraryScroll" Padding="24,18,18,24" ScrollChanged="LibraryScroll_ScrollChanged">
                            <ItemsControl x:Name="GameList" Focusable="True" FocusVisualStyle="{x:Null}"
                                          GotKeyboardFocus="GameList_GotKeyboardFocus">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding CoverWidth}" Height="{Binding CoverHeight}" Margin="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#0B1423" BorderThickness="2" CornerRadius="8"
                                                RenderTransformOrigin="0.5,0.5"
                                                MouseEnter="Cover_MouseEnter"
                                                MouseLeftButtonUp="Cover_Click" MouseRightButtonUp="Cover_RightClick"
                                                ToolTip="Clique esquerdo: jogar • clique direito: personalizar">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Background" Value="#0B1423"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsControllerSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                                                            <Setter Property="BorderThickness" Value="3"/>
                                                            <Setter Property="Background" Value="#10283A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid ClipToBounds="True">
                                                <Image Source="{Binding DisplayCover, Converter={StaticResource CoverImageConverter}}"
                                                       Stretch="Uniform" SnapsToDevicePixels="True"
                                                       SizeChanged="FramedArtworkImage_SizeChanged"/>

                                                <Border Style="{StaticResource LudaryxGameBadge}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                                    <TextBlock Text="{Binding PlatformDisplay}" Foreground="#D9E9F8"
                                                               FontSize="8" FontWeight="SemiBold"/>
                                                </Border>

                                                <Border Style="{StaticResource LudaryxGameBadge}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7"
                                                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="★" Foreground="#FFD86A" FontSize="10"/>
                                                </Border>

                                                <Border Style="{StaticResource LudaryxGameBadge}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7"
                                                        Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="DUPLICATA" Foreground="#E4C576" FontSize="8" FontWeight="Bold"/>
                                                </Border>

                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7"
                                                        Padding="7,3" CornerRadius="5" Background="#D90E7490"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="● JOGANDO" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button x:Name="BackToTopButton"
                                Content="VOLTAR AO TOPO"
                                Style="{StaticResource NavButton}"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,28,24"
                                Padding="14,8"
                                Panel.ZIndex="20"
                                Click="BackToTop_Click"/>

                        <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Nenhum jogo encontrado" Foreground="White"
                                       FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nenhum item corresponde aos filtros atuais."
                                       Foreground="#8294AA" Margin="0,7,0,14" HorizontalAlignment="Center"/>
                            <Button Content="LIMPAR FILTROS" Click="ClearFilters_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Desktop selected-game panel. -->
                <Border x:Name="SelectedGamePanel" Grid.Column="1"
                        Style="{StaticResource LudaryxSelectedPanel}"
                        GotKeyboardFocus="SidePanelRegion_GotKeyboardFocus"
                        Background="{DynamicResource SelectedPanelBackground}"
                        BorderBrush="{DynamicResource SelectedPanelBorder}"
                        Margin="0,12,14,14">
                    <ScrollViewer x:Name="SelectedGameScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="SelectedGameScrollViewer_SizeChanged">
                        <StackPanel>
                            <Border x:Name="SelectedArtworkBorder" Height="160" Background="{DynamicResource SelectedPanelArtworkBackground}" CornerRadius="8" ClipToBounds="True"
                                    BorderBrush="{DynamicResource SelectedPanelArtworkBorder}" BorderThickness="1">
                                <Image x:Name="SelectedArtworkImage" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       SizeChanged="FramedArtworkImage_SizeChanged"/>
                            </Border>
                            <TextBlock x:Name="SelectedGameNameText" Text="Selecione um jogo"
                                       Foreground="{DynamicResource SelectedPanelTextPrimary}" FontSize="20" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                            <TextBlock x:Name="SelectedGameMetaText" Foreground="{DynamicResource SelectedPanelMeta}"
                                       FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedGameUsageText" Foreground="{DynamicResource SelectedPanelTextSecondary}"
                                       FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/>

                            <Border Height="1" Background="{DynamicResource SelectedPanelDivider}" Margin="0,13"/>

                            <TextBlock Text="Descrição" Foreground="{DynamicResource SelectedPanelTextSecondary}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedGameDescriptionText" Foreground="{DynamicResource SelectedPanelTextPrimary}"
                                       FontSize="11" TextWrapping="Wrap" MaxHeight="94" Margin="0,5,0,0"/>

                            <StackPanel Margin="0,16,0,0">
                                <Button x:Name="SelectedPlayButton" Content="JOGAR"
                                        Style="{StaticResource LudaryxHeroPrimaryButton}"
                                        Click="SelectedPlay_Click" Margin="0,0,0,7"/>
                                <Button x:Name="SelectedDetailsButton" Content="DETALHES / PERSONALIZAR"
                                        Click="SelectedDetails_Click" Margin="0,0,0,7"/>
                                <Button x:Name="SelectedFavoriteButton" Content="☆ FAVORITO"
                                        Click="SelectedFavorite_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Adaptive footer. -->
        <Border x:Name="FooterBorder" Grid.Row="5" Background="#05070B"
                BorderBrush="#1B293A" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
                <TextBlock x:Name="ControllerStatusText" Grid.Column="0"
                           Text="Controle: procurando..." Foreground="#DCE6F3"
                           FontSize="10" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="XboxFooterHints" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Style="{StaticResource FooterHintChip}">
                            <TextBlock x:Name="XboxSelectHintText" Text="A  JOGAR" Foreground="#DFFFE7" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource FooterHintChip}">
                            <TextBlock x:Name="XboxCustomizeHintText" Text="X  PERSONALIZAR" Foreground="#DDEEFF" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource FooterHintChip}">
                            <TextBlock x:Name="XboxExtraHintText" Text="Y  FAVORITO" Foreground="#C9D5E4" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PlayStationFooterHints" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Style="{StaticResource FooterHintChip}">
                            <TextBlock x:Name="PlayStationSelectHintText" Text="X  JOGAR" Foreground="#DDEEFF" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource FooterHintChip}">
                            <TextBlock x:Name="PlayStationCustomizeHintText" Text="□  PERSONALIZAR" Foreground="#F1DEFF" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource FooterHintChip}">
                            <TextBlock x:Name="PlayStationExtraHintText" Text="△  FAVORITO" Foreground="#C9D5E4" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="KeyboardFooterHints" Orientation="Horizontal">
                        <Border Style="{StaticResource FooterHintChip}">
                            <TextBlock x:Name="KeyboardSelectHintText" Text="ENTER  JOGAR" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource FooterHintChip}">
                            <TextBlock x:Name="KeyboardCustomizeHintText" Text="SPACE  PERSONALIZAR" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource FooterHintChip}">
                            <TextBlock x:Name="KeyboardExtraHintText" Text="F  FAVORITO   •   F11  TELA CHEIA" Foreground="#C9D5E4" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ToastBorder"
                Grid.RowSpan="6"
                Panel.ZIndex="5000"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="24"
                Padding="16,10"
                MaxWidth="680"
                Background="#F20A1420"
                BorderBrush="#39759A"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Game launch overlay: shown while the selected integration prepares/starts the game. -->
        <Grid x:Name="GameLaunchOverlay"
              Grid.RowSpan="6"
              Panel.ZIndex="9000"
              Visibility="Collapsed"
              Background="{DynamicResource LaunchOverlayBackdrop}"
              IsHitTestVisible="True">
            <Border Width="650"
                    MaxWidth="760"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource LaunchOverlayPanel}"
                    BorderBrush="{DynamicResource LaunchOverlayBorder}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="190"
                            Height="285"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource LaunchOverlayArtworkBackground}"
                            BorderBrush="{DynamicResource LaunchOverlayArtworkBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <Image x:Name="GameLaunchCoverImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="ABRINDO JOGO"
                                   Foreground="{DynamicResource LaunchOverlayTextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"/>
                        <TextBlock x:Name="GameLaunchNameText"
                                   Text="Jogo"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource LaunchOverlayTextPrimary}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="GameLaunchStatusText"
                                   Text="Preparando inicialização..."
                                   Margin="0,8,0,20"
                                   Foreground="{DynamicResource LaunchOverlayTextSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <ProgressBar x:Name="GameLaunchProgressBar"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     IsIndeterminate="True"
                                     Background="{DynamicResource LaunchProgressTrack}"
                                     Foreground="{DynamicResource LaunchProgressNeon}"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Startup overlay remains unchanged in behavior. -->
        <Grid x:Name="StartupOverlay" Grid.RowSpan="6" Panel.ZIndex="9999"
              Background="#02050C" Opacity="1" IsHitTestVisible="True">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1240" Height="380">
                <Ellipse x:Name="StartupGlowHalo" Width="900" Height="150" Fill="#1AAEFF" Opacity="0"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,42,0,0">
                    <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
                </Ellipse>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid x:Name="StartupLogoHost" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="StartupLogoScale" ScaleX="0.92" ScaleY="0.92"/>
                        </Grid.RenderTransform>
                        <Image Source="pack://application:,,,/Assets/LUDARYX.png"
                               Width="940" Stretch="Uniform" SnapsToDevicePixels="True"
                               HorizontalAlignment="Center"/>
                    </Grid>
                    <Rectangle x:Name="StartupAccentLine" Width="0" Height="3" Opacity="0"
                               Fill="#2AB0FF" RadiusX="2" RadiusY="2"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock x:Name="StartupLibraryLoadingText" Text="CARREGANDO BIBLIOTECA..."
                               Visibility="Collapsed" Foreground="#DCE9FF"
                               FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" Panel.ZIndex="10000"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>

</Window>
