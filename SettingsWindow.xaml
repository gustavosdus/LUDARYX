<Window x:Class="UnifiedGameLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Configurações"
        Width="1080" Height="820"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource LudaryxWindowBackground}"
        Foreground="{StaticResource LudaryxTextPrimary}"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="#070A10"
                BorderBrush="#1A2635" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource LudaryxRed}" Margin="0,0,9,0"/>
                    <TextBlock Text="LUDARYX" FontWeight="Bold" FontSize="12" Foreground="#F3F6FB" VerticalAlignment="Center"/>
                    <TextBlock Text="  /  Configurações" FontSize="11" Foreground="#7F91A8" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="—" Click="MinimizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="□" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="×" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header -->
        <Grid Grid.Row="1" Margin="28,20,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Configurações" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Controle a biblioteca, aparência, integrações, backup e itens locais."
                           Foreground="{StaticResource LudaryxTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#0A121E" BorderBrush="{StaticResource LudaryxBorder}"
                    BorderThickness="1" CornerRadius="7" Height="36" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="⌕" Foreground="#6F859F" FontSize="18" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    <TextBox x:Name="SettingsSearchBox"
                             Margin="32,0,8,0"
                             Background="Transparent" BorderThickness="0"
                             Padding="4,0" MinHeight="0"
                             TextChanged="SettingsSearchBox_TextChanged"
                             ToolTip="Buscar nas configurações"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings content -->
        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="2"
                      Margin="22,0,14,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel Margin="6,0,10,18">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LibrarySection" Grid.Column="0" Style="{StaticResource LudaryxCard}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="Biblioteca" Style="{StaticResource LudaryxSectionTitle}"/>
                            <CheckBox x:Name="ShowStoreAppsCheck" Content="Mostrar Xbox / Microsoft Store" Margin="0,5,0,0"/>
                            <CheckBox x:Name="ShowHiddenCheck" Content="Mostrar itens ocultos na biblioteca" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ExecutionSection" Grid.Column="1" Style="{StaticResource LudaryxCard}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="Execução" Style="{StaticResource LudaryxSectionTitle}"/>
                            <CheckBox x:Name="AutoStartClientsCheck" Content="Iniciar clientes automaticamente" Margin="0,5,0,0"/>
                            <CheckBox x:Name="KeepLauncherOpenCheck" Content="Manter launcher aberto" Margin="0,10,0,0"/>
                            <CheckBox x:Name="StartWithWindowsCheck" Content="Iniciar LUDARYX com o Windows" Margin="0,10,0,0"/>
                            <CheckBox x:Name="StartFullscreenCheck" Content="Abrir em tela cheia ao iniciar" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AppearanceSection" Grid.Column="2" Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Aparência" Style="{StaticResource LudaryxSectionTitle}"/>
                            <Grid Grid.Row="1" Margin="0,2,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Capas" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CoverModeCombo" Grid.Column="1">
                                    <ComboBoxItem Content="Auto" Tag="Auto"/>
                                    <ComboBoxItem Content="Horizontal" Tag="Horizontal"/>
                                    <ComboBoxItem Content="Vertical" Tag="Vertical"/>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Linha neon" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="NeonLineColorCombo" Grid.Column="1">
                                    <ComboBoxItem Content="Vermelha" Tag="Red"/>
                                    <ComboBoxItem Content="Azul claro" Tag="LightBlue"/>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Tema" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1">
                                    <ComboBoxItem Content="Escuro" Tag="Dark"/>
                                    <ComboBoxItem Content="Claro" Tag="Light"/>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Idioma" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="LanguageCombo" Grid.Column="1">
                                    <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/>
                                    <ComboBoxItem Content="Português (Portugal)" Tag="pt-PT"/>
                                    <ComboBoxItem Content="English (US)" Tag="en-US"/>
                                    <ComboBoxItem Content="English (UK)" Tag="en-GB"/>
                                    <ComboBoxItem Content="Español (Latinoamérica)" Tag="es-419"/>
                                    <ComboBoxItem Content="Español (España)" Tag="es-ES"/>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SteamGridDbSection" Grid.Column="0" Style="{StaticResource LudaryxCard}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="SteamGridDB" Style="{StaticResource LudaryxSectionTitle}"/>
                            <TextBlock Text="Use a API Key para buscar capas verticais e horizontais, inclusive de jogos de outros launchers."
                                       Foreground="{StaticResource LudaryxTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="SteamGridDbApiKeyBox" ToolTip="API Key do SteamGridDB"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="UpdatesSection" Grid.Column="1" Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Atualizações" Style="{StaticResource LudaryxSectionTitle}"/>
                            <TextBlock Text="Verifique novas versões publicadas no GitHub."
                                       Foreground="{StaticResource LudaryxTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CheckForUpdatesOnStartupCheck" Content="Procurar atualizações ao iniciar"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="CheckUpdatesNowButton" Content="VERIFICAR AGORA" Click="CheckUpdatesNow_Click"/>
                                <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource LudaryxTextSecondary}" Margin="12,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="DuplicatesSection" Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Duplicatas" Style="{StaticResource LudaryxSectionTitle}"/>
                            <CheckBox x:Name="AutoHideDuplicateSecondaryCheck" Content="Ocultar automaticamente versões duplicadas secundárias" Margin="0,4,0,0"/>
                            <CheckBox x:Name="ShowOnlyPrimaryDuplicatesCheck" Content="Mostrar somente a versão principal de duplicatas" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Prioridade automática por plataforma" Foreground="{StaticResource LudaryxTextSecondary}" Margin="0,0,0,5"/>
                            <TextBox x:Name="DuplicatePriorityBox"/>
                            <TextBlock Text="Separe as plataformas por vírgulas. Você também pode escolher a versão principal na tela de detalhes."
                                       Foreground="#6F829A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CacheSection" Grid.Column="0" Style="{StaticResource LudaryxCard}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="Cache e backup" Style="{StaticResource LudaryxSectionTitle}"/>
                            <CheckBox x:Name="AutoCleanupCacheCheck" Content="Limpar cache automaticamente quando atingir o limite"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                                <TextBlock Text="Limite do cache (MB)" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="MaxCacheSizeBox" Width="90"/>
                                <TextBlock x:Name="CacheSizeText" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="O backup pode preservar configurações, favoritos, jogos manuais e artes personalizadas. O cache automático de capas é regenerável."
                                       Foreground="#778AA3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Content="LIMPAR CACHE AGORA" Click="ClearCache_Click" Margin="0,0,8,8"/>
                                <Button Content="EXPORTAR BACKUP" Click="ExportBackup_Click" Margin="0,0,8,8"/>
                                <Button Content="IMPORTAR BACKUP" Click="ImportBackup_Click" Margin="0,0,8,8"/>
                                <Button Content="ABRIR PASTA DE DADOS" Click="OpenDataFolder_Click" Margin="0,0,8,8"/>
                                <Button Content="COPIAR DIAGNÓSTICO" Click="CopyDiagnostic_Click" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ShortcutsSection" Grid.Column="1" Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Atalhos de teclado" Style="{StaticResource LudaryxSectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Pesquisar" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ShortcutSearchBox" Grid.Column="1" Margin="8,3,0,3"/>
                                <TextBlock Grid.Row="1" Text="Tela cheia" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ShortcutFullscreenBox" Grid.Row="1" Grid.Column="1" Margin="8,3,0,3"/>
                                <TextBlock Grid.Row="2" Text="Atualizar biblioteca" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ShortcutRefreshBox" Grid.Row="2" Grid.Column="1" Margin="8,3,0,3"/>
                                <TextBlock Grid.Row="3" Text="Configurações" Foreground="{StaticResource LudaryxTextSecondary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ShortcutSettingsBox" Grid.Row="3" Grid.Column="1" Margin="8,3,0,3"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="IntegrationsSection" Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Status das integrações" Style="{StaticResource LudaryxSectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock Text="Mostra os clientes encontrados, status e detalhes de diagnóstico."
                                           Foreground="{StaticResource LudaryxTextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="ATUALIZAR STATUS" Click="RefreshIntegrationStatus_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="IntegrationStatusList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#09131F" BorderBrush="#172A3D" BorderThickness="1" CornerRadius="6" Margin="0,2">
                                        <Grid Margin="10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="#E8EDF5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#80D7FF" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="#70839A" FontSize="10"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="3" Content="ABRIR CLIENTE" Tag="{Binding}" Click="OpenIntegrationClient_Click" Margin="8,0,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource LudaryxButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanOpenClient}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="ManageItemsSection" Style="{StaticResource LudaryxCard}" Padding="16,14,16,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="380"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Gerenciar itens" Style="{StaticResource LudaryxSectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock Text="Oculte, restaure ou recupere jogos excluídos da biblioteca."
                                           Foreground="{StaticResource LudaryxTextSecondary}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#09131F" BorderBrush="{StaticResource LudaryxBorder}" BorderThickness="1" CornerRadius="6" Height="34">
                                <Grid>
                                    <TextBlock Text="⌕" Foreground="#6F859F" FontSize="17" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBox x:Name="ManageItemsSearchBox" Margin="31,0,6,0" Background="Transparent" BorderThickness="0"
                                             Padding="3,0" MinHeight="0" TextChanged="ManageItemsSearchBox_TextChanged"
                                             ToolTip="Buscar jogos"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Background="#08111C" BorderBrush="#172B40" BorderThickness="1" CornerRadius="7" Margin="0,10,0,0" Padding="6">
                            <ListBox x:Name="GamesList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#13263A" BorderThickness="0,0,0,1" Padding="4,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ProviderId}" Foreground="#6F829A" FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="FAVORITO" Foreground="#D7B46A" VerticalAlignment="Center" Margin="10"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                                <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,4,0" ToolTip="Mostrar"/>
                                                <Button Grid.Column="3" Content="RESTAURAR" Tag="{Binding}" Click="RestoreExcluded_Click" Margin="8,0,0,0"
                                                        Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed footer -->
        <Border Grid.Row="3" Background="#080C13" BorderBrush="#1B2A3B" BorderThickness="0,1,0,0">
            <Grid Margin="24,9">
                <Button Content="SOBRE / CRÉDITOS" Width="160" HorizontalAlignment="Left" Click="About_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCELAR" Width="120" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Content="SALVAR" Width="120" Style="{StaticResource LudaryxPrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>