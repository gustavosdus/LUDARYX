<Window x:Class="UnifiedGameLauncher.SteamGridDbArtworkPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Escolher arte do SteamGridDB" Width="1000" Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource LudaryxWindowBackground}"
        Foreground="{DynamicResource LudaryxTextPrimary}"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource LudaryxTitleBarBackground}"
                BorderBrush="{DynamicResource LudaryxTitleBarBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource LudaryxRed}" Margin="0,0,9,0"/>
                    <TextBlock Text="LUDARYX"
                               Foreground="{DynamicResource LudaryxTextPrimary}"
                               FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="  /  SteamGridDB / Artes"
                               Foreground="{DynamicResource LudaryxTitleBarSecondaryText}"
                               FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="—" Click="MinimizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="□" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="×" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Text="ESCOLHER ARTE" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="24" FontWeight="Bold"/>
        <TextBlock x:Name="InfoText" Grid.Row="1" Foreground="{DynamicResource LudaryxTextSecondary}" Margin="0,5,0,12"/>
        <ListBox x:Name="ArtworkList" Grid.Row="2" Background="{DynamicResource LudaryxListBackground}" BorderThickness="0" Foreground="{DynamicResource LudaryxTextPrimary}" SelectionChanged="ArtworkList_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="210" Height="245" Margin="6" Padding="5" Background="{DynamicResource LudaryxItemBackground}" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="175"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Source="{Binding Thumb}" Stretch="Uniform" MouseLeftButtonUp="ArtworkImage_Click" Cursor="Hand"/>
                            <StackPanel Grid.Row="1" Margin="3,5,3,0">
                                <TextBlock Text="{Binding Width, StringFormat={}{0}}" Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11"/>
                                <TextBlock Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="11" TextWrapping="Wrap">
                                    <Run Text="Pontuação: "/><Run Text="{Binding Score}"/>
                                </TextBlock>
                                <Button Content="USAR ESTA ARTE" Tag="{Binding}" Click="Use_Click" Margin="0,4,0,0" Height="28"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="UseSelectedButton" Content="USAR SELECIONADA" Width="160" Margin="0,0,8,0" Click="UseSelected_Click" IsEnabled="False"/>
            <Button Content="FECHAR" Width="110" Click="Close_Click"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
