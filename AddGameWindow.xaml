<Window x:Class="UnifiedGameLauncher.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Adicionar jogo"
        Width="820" Height="760"
        MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource LudaryxWindowBackground}"
        Foreground="{DynamicResource LudaryxTextPrimary}"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource LudaryxTitleBarBackground}"
                BorderBrush="{DynamicResource LudaryxTitleBarBorder}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource LudaryxRed}" Margin="0,0,9,0"/>
                    <TextBlock Text="LUDARYX" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="  /  Jogo manual" Foreground="{DynamicResource LudaryxTitleBarSecondaryText}" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="—" Click="MinimizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="□" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="×" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,20,28,14">
            <TextBlock x:Name="HeaderText" Text="ADICIONAR JOGO MANUALMENTE"
                       Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Configure como o LUDARYX deve iniciar este jogo. Você pode editar estas opções novamente depois."
                       Foreground="{DynamicResource LudaryxTextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      Margin="22,0,14,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel Margin="6,0,10,18">

                <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nome" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Nome exibido na biblioteca." Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11" Margin="0,3,12,0"/>
                        </StackPanel>
                        <TextBox x:Name="NameBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Perfil de inicialização" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Use perfis para argumentos ou modos diferentes." Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11" Margin="0,3,12,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProfileCombo" SelectionChanged="ProfileCombo_SelectionChanged" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="NOVO PERFIL" Click="NewProfile_Click" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="EXCLUIR PERFIL" Style="{StaticResource LudaryxDangerButton}" Click="DeleteProfile_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nome do perfil" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Identificação deste perfil." Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11" Margin="0,3,12,0"/>
                        </StackPanel>
                        <TextBox x:Name="ProfileNameBox" Grid.Column="1"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Executável (.exe)" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Arquivo principal do jogo." Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11" Margin="0,3,12,0"/>
                        </StackPanel>
                        <TextBox x:Name="ExeBox" Grid.Column="1" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="PROCURAR" Width="104" Click="BrowseExe_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Argumentos de inicialização" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Parâmetros adicionais (opcional)." Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11" Margin="0,3,12,0"/>
                        </StackPanel>
                        <TextBox x:Name="ArgumentsBox" Grid.Column="1"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="URI de inicialização" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Comando URI personalizado (opcional)." Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11" Margin="0,3,12,0"/>
                        </StackPanel>
                        <TextBox x:Name="UriBox" Grid.Column="1"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pasta de trabalho" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Diretório de trabalho do jogo (opcional)." Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11" Margin="0,3,12,0"/>
                        </StackPanel>
                        <TextBox x:Name="WorkingDirectoryBox" Grid.Column="1" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="PROCURAR" Width="104" Click="BrowseWorkingDirectory_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Privilégios" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Use apenas quando o jogo exigir." Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11" Margin="0,3,12,0"/>
                        </StackPanel>
                        <CheckBox x:Name="RunAsAdministratorCheck" Grid.Column="1"
                                  Content="Executar como administrador" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ícone personalizado" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Imagem ou ícone do jogo (opcional)." Foreground="{DynamicResource LudaryxTextSecondary}" FontSize="11" Margin="0,3,12,0"/>
                        </StackPanel>
                        <TextBox x:Name="IconPathBox" Grid.Column="1" Margin="0,0,8,0" IsReadOnly="True"/>
                        <Button Grid.Column="2" Content="PROCURAR" Width="104" Click="BrowseIcon_Click"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource LudaryxPanelBackgroundAlt}" BorderBrush="{DynamicResource LudaryxBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <TextBlock Text="Crie perfis diferentes para iniciar o mesmo jogo com argumentos distintos, por exemplo Normal, Sem mods ou Modo janela. O perfil selecionado será usado ao iniciar."
                               Foreground="{DynamicResource LudaryxTextSecondary}" TextWrapping="Wrap" LineHeight="19"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource LudaryxTitleBarBackground}" BorderBrush="{DynamicResource LudaryxTitleBarBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="24,9">
                <Button Content="CANCELAR" Width="120" HorizontalAlignment="Right" Margin="0,0,132,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="ADICIONAR" Width="120" HorizontalAlignment="Right"
                        Style="{StaticResource LudaryxPrimaryButton}" Click="Add_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>