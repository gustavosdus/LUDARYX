<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared LUDARYX control palette. These resources intentionally replace
         the stock Windows look for ordinary WPF controls across the app. -->
    <SolidColorBrush x:Key="LudaryxWindowBackground" Color="#070B12"/>
    <SolidColorBrush x:Key="LudaryxPanelBackground" Color="#0B1320"/>
    <SolidColorBrush x:Key="LudaryxPanelBackgroundAlt" Color="#0E1826"/>
    <SolidColorBrush x:Key="LudaryxInputBackground" Color="#0D1724"/>
    <SolidColorBrush x:Key="LudaryxBorder" Color="#233A55"/>
    <SolidColorBrush x:Key="LudaryxBorderHover" Color="#3C6B93"/>
    <SolidColorBrush x:Key="LudaryxBlue" Color="#59C7FF"/>
    <SolidColorBrush x:Key="LudaryxBlueMuted" Color="#173C57"/>
    <SolidColorBrush x:Key="LudaryxRed" Color="#FF1744"/>
    <SolidColorBrush x:Key="LudaryxRedDark" Color="#5B1627"/>
    <SolidColorBrush x:Key="LudaryxTextPrimary" Color="#F2F6FC"/>
    <SolidColorBrush x:Key="LudaryxTextSecondary" Color="#95A6BB"/>
    <SolidColorBrush x:Key="LudaryxDisabled" Color="#536174"/>
    <SolidColorBrush x:Key="LudaryxTitleBarBackground" Color="#070A10"/>
    <SolidColorBrush x:Key="LudaryxTitleBarBorder" Color="#1A2635"/>
    <SolidColorBrush x:Key="LudaryxTitleBarSecondaryText" Color="#7F91A8"/>
    <SolidColorBrush x:Key="LudaryxListBackground" Color="#151923"/>
    <SolidColorBrush x:Key="LudaryxItemBackground" Color="#1A1F2A"/>
    <SolidColorBrush x:Key="LudaryxItemHoverBackground" Color="#202836"/>
    <SolidColorBrush x:Key="LudaryxBadgeBackground" Color="#0D1D2E"/>
    <SolidColorBrush x:Key="LudaryxBadgeForeground" Color="#BFEAFF"/>
    <SolidColorBrush x:Key="LudaryxFooterChipBackground" Color="#07121F"/>
    <SolidColorBrush x:Key="LudaryxFooterChipBorder" Color="#203A55"/>
    <SolidColorBrush x:Key="LudaryxFooterChipText" Color="#F3F7FB"/>
    <SolidColorBrush x:Key="SelectionAccentBorder" Color="#66F5FF"/>
    <SolidColorBrush x:Key="SearchCaretBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LudaryxCheckBackground" Color="#0A1320"/>
    <SolidColorBrush x:Key="LudaryxCheckBorder" Color="#3B5068"/>
    <SolidColorBrush x:Key="LudaryxComboPopupBackground" Color="#09121D"/>
    <SolidColorBrush x:Key="LudaryxComboItemHoverBackground" Color="#173047"/>
    <SolidColorBrush x:Key="LudaryxComboItemSelectedBackground" Color="#153952"/>
    <SolidColorBrush x:Key="LudaryxComboArrow" Color="#A9B8C9"/>
    <SolidColorBrush x:Key="LudaryxFilterChipBackground" Color="#102238"/>
    <SolidColorBrush x:Key="LudaryxFilterChipBorder" Color="#285275"/>
    <SolidColorBrush x:Key="LudaryxFilterChipForeground" Color="#BFEAFF"/>
    <SolidColorBrush x:Key="LudaryxSeparator" Color="#203044"/>
    <SolidColorBrush x:Key="LudaryxSelectedPanelBackground" Color="#0A1421"/>
    <SolidColorBrush x:Key="LudaryxSelectedPanelBorder" Color="#1E3850"/>
    <SolidColorBrush x:Key="LudaryxDangerBackground" Color="#24111B"/>
    <SolidColorBrush x:Key="LudaryxDangerBorder" Color="#7D233A"/>
    <SolidColorBrush x:Key="LudaryxDangerForeground" Color="#FF93A7"/>

    <Style x:Key="LudaryxCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LudaryxPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="LudaryxSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="LudaryxLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <SolidColorBrush x:Key="LudaryxButtonBackground" Color="#111D2C"/>
    <SolidColorBrush x:Key="LudaryxButtonHoverBackground" Color="#17273A"/>
    <SolidColorBrush x:Key="LudaryxButtonPressedBackground" Color="#1B324A"/>
    <SolidColorBrush x:Key="LudaryxButtonForeground" Color="#F5F7FA"/>

    <Style x:Key="LudaryxButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource LudaryxButtonForeground}"/>
        <Setter Property="Background" Value="{DynamicResource LudaryxButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LudaryxButtonHoverBackground}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LudaryxButtonPressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource LudaryxDisabled}"/>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LudaryxPrimaryButton" TargetType="Button" BasedOn="{StaticResource LudaryxButton}">
        <Setter Property="Background" Value="#D9153C"/>
        <Setter Property="BorderBrush" Value="#FF3158"/>
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="LudaryxDangerButton" TargetType="Button" BasedOn="{StaticResource LudaryxButton}">
        <Setter Property="Background" Value="{DynamicResource LudaryxDangerBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxDangerBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource LudaryxDangerForeground}"/>
    </Style>

    <Style x:Key="LudaryxWindowButton" TargetType="Button" BasedOn="{StaticResource LudaryxButton}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource LudaryxButton}"/>

    <Style x:Key="LudaryxTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource LudaryxInputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="#527CA3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LudaryxBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource LudaryxDisabled}"/>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource LudaryxTextBox}"/>

    <Style x:Key="LudaryxPasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource LudaryxInputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LudaryxBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource LudaryxPasswordBox}"/>

    <Style x:Key="LudaryxCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource LudaryxCheckBackground}"
                                BorderBrush="{DynamicResource LudaryxCheckBorder}"
                                BorderThickness="1"
                                CornerRadius="3"/>
                        <Path x:Name="CheckMark"
                              Grid.Column="0"
                              Width="9" Height="7"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="4,0,0,1"
                              Stroke="White"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 0 3 L 3 6 L 9 0"
                              Visibility="Collapsed"/>
                        <ContentPresenter Grid.Column="1"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource LudaryxRed}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FF5270"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource LudaryxDisabled}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource LudaryxCheckBox}"/>

    <Style x:Key="LudaryxComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LudaryxComboItemHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LudaryxComboItemSelectedBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource LudaryxComboBoxItem}"/>

    <Style x:Key="LudaryxComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource LudaryxInputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource LudaryxComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Margin="10,0,4,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"/>
                            <ToggleButton Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,11,0"
                                                  Fill="{DynamicResource LudaryxComboArrow}"
                                                  Data="M 0 0 L 8 0 L 4 5 Z"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="320"
                                    Margin="0,3,0,0"
                                    Padding="4"
                                    Background="{DynamicResource LudaryxComboPopupBackground}"
                                    BorderBrush="{DynamicResource LudaryxBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LudaryxBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource LudaryxComboBox}"/>

    <Style x:Key="LudaryxListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource LudaryxBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource LudaryxItemHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource LudaryxPanelBackgroundAlt}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem" BasedOn="{StaticResource LudaryxListBoxItem}"/>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource LudaryxTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <ControlTemplate x:Key="LudaryxVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Background="{DynamicResource LudaryxBorder}" MinHeight="34">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="ThumbChrome" Width="6" Margin="2,0"
                                        Background="{TemplateBinding Background}" CornerRadius="3"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource SelectionAccentBorder}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="LudaryxHorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Background="Transparent" BorderThickness="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Background="{DynamicResource LudaryxBorder}" MinWidth="34">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="ThumbChrome" Height="6" Margin="0,2"
                                        Background="{TemplateBinding Background}" CornerRadius="3"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource SelectionAccentBorder}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Background="Transparent" BorderThickness="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Template" Value="{StaticResource LudaryxVerticalScrollBarTemplate}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template" Value="{StaticResource LudaryxHorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource LudaryxPanelBackgroundAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource LudaryxBadgeForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LudaryxIconButton" TargetType="Button" BasedOn="{StaticResource LudaryxButton}">
        <Setter Property="MinWidth" Value="38"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="LudaryxFilterChip" TargetType="Button" BasedOn="{StaticResource LudaryxButton}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource LudaryxFilterChipBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxFilterChipBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource LudaryxFilterChipForeground}"/>
    </Style>

    <Style x:Key="LudaryxHeroButton" TargetType="Button" BasedOn="{StaticResource LudaryxButton}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="LudaryxHeroPrimaryButton" TargetType="Button" BasedOn="{StaticResource LudaryxPrimaryButton}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="22,9"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="LudaryxGameBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LudaryxBadgeBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>

    <Style x:Key="LudaryxSelectedPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LudaryxSelectedPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LudaryxSelectedPanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource LudaryxSeparator}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>
</ResourceDictionary>