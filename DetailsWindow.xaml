<Window x:Class="UnifiedGameLauncher.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes do jogo" Width="1000" Height="700"
        WindowStartupLocation="CenterOwner" Background="#0D0F14">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock Text="CAPA VERTICAL" Foreground="#9BA3B4" FontSize="11" Margin="0,0,0,7"/>
            <Border Height="430" Background="#151923" CornerRadius="10" Padding="4">
                <Image x:Name="VerticalCoverImage" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="CAPA HORIZONTAL" Foreground="#9BA3B4" FontSize="11" Margin="0,14,0,7"/>
            <Border Height="135" Background="#151923" CornerRadius="10" Padding="4">
                <Image x:Name="HorizontalCoverImage" Stretch="Uniform"/>
            </Border>
        </StackPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="PlatformText" Foreground="#9BA3B4" FontSize="14" Margin="0,5,0,8"/>
                <Border x:Name="DuplicatePrimaryBadge" Background="#243247" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="DuplicatePrimaryBadgeText" Foreground="#7DD3FC" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <WrapPanel Margin="0,0,0,15">
                    <Button x:Name="FavoriteButton" Content="☆ FAVORITO" Click="Favorite_Click" Margin="0,0,8,0"/>
                    <Button Content="JOGAR" Click="Play_Click" Margin="0,0,8,0"/>
                    <Button Content="OCULTAR" Click="Hide_Click" Margin="0,0,8,0"/>
                    <Button Content="EXCLUIR DA BIBLIOTECA" Click="Exclude_Click" Margin="0,0,8,0"/>
                    <Button x:Name="EditManualLaunchButton" Content="EDITAR INICIALIZAÇÃO" Click="EditManualLaunch_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="DuplicateManualGameButton" Content="DUPLICAR ENTRADA" Click="DuplicateManualGame_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="OpenInstallFolderButton" Content="ABRIR PASTA DO JOGO" Click="OpenInstallFolder_Click" Margin="0,0,8,0"/>
                    <Button Content="ATUALIZAR METADADOS" Click="RefreshMetadata_Click" Margin="0,0,8,0"/>
                    <Button x:Name="MakePrimaryDuplicateButton" Content="TORNAR ESTA VERSÃO PRINCIPAL" Click="MakePrimaryDuplicate_Click" Visibility="Collapsed"/>
                </WrapPanel>
                <Border Background="#151923" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Gêneros" Foreground="#9BA3B4"/>
                        <TextBlock x:Name="GenreText" Grid.Row="1" Foreground="White" FontSize="16" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="Desenvolvedor / Publicadora" Grid.Row="2" Foreground="#9BA3B4"/>
                        <TextBlock x:Name="CompanyText" Grid.Row="3" Foreground="White" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="Lançamento" Grid.Row="4" Foreground="#9BA3B4"/>
                        <TextBlock x:Name="ReleaseText" Grid.Row="5" Foreground="White" Margin="0,4,0,12"/>
                        <TextBlock Text="Classificação indicativa" Grid.Row="6" Foreground="#9BA3B4"/>
                        <TextBlock x:Name="AgeRatingText" Grid.Row="7" Foreground="White" Margin="0,4,0,12"/>
                        <TextBlock Text="Uso local" Grid.Row="8" Foreground="#9BA3B4"/>
                        <TextBlock x:Name="UsageText" Grid.Row="9" Foreground="White" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="Instalação" Grid.Row="10" Foreground="#9BA3B4"/>
                        <TextBlock x:Name="InstallPathText" Grid.Row="11" Foreground="White" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="RunningText" Grid.Row="12" Foreground="#66F5FF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="DuplicateText" Grid.Row="13" Foreground="#D7B46A" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <TextBlock Text="Descrição" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,7"/>
                <TextBlock x:Name="DescriptionText" Foreground="#D9DDE7" TextWrapping="Wrap" LineHeight="22"/>
                <TextBlock x:Name="MetadataSourceText" Foreground="#7F8AA3" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="Classificação manual" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,8"/>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBox x:Name="ManualNameBox" Grid.Row="0" Margin="0,3" ToolTip="Nome"/>
                    <TextBox x:Name="ManualGenresBox" Grid.Row="1" Margin="0,3" ToolTip="Gêneros separados por vírgula"/>
                    <TextBox x:Name="ManualDeveloperBox" Grid.Row="2" Margin="0,3" ToolTip="Desenvolvedor"/>
                    <TextBox x:Name="ManualPublisherBox" Grid.Row="3" Margin="0,3" ToolTip="Publicadora"/>
                    <TextBox x:Name="ManualReleaseYearBox" Grid.Row="4" Margin="0,3" ToolTip="Ano de lançamento"/>
                    <TextBox x:Name="ManualAgeRatingBox" Grid.Row="5" Margin="0,3" ToolTip="Classificação indicativa do sistema correspondente ao idioma atual"/>
                    <TextBox x:Name="ManualDescriptionBox" Grid.Row="6" Margin="0,3" Height="80" TextWrapping="Wrap" AcceptsReturn="True" ToolTip="Descrição"/>
                </Grid>
                <TextBlock Text="Artes personalizadas" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,8"/>
                <TextBlock Text="As imagens escolhidas são copiadas para a pasta do LUDARYX e não dependem do arquivo original." Foreground="#9BA3B4" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="ESCOLHER CAPA VERTICAL" Click="ChooseVerticalArtwork_Click" Margin="0,0,8,0"/>
                    <Button Content="RESTAURAR VERTICAL" Click="RestoreVerticalArtwork_Click"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="ESCOLHER ARTE HORIZONTAL" Click="ChooseHorizontalArtwork_Click" Margin="0,0,8,0"/>
                    <Button Content="RESTAURAR HORIZONTAL" Click="RestoreHorizontalArtwork_Click"/>
                </WrapPanel>
                <TextBlock Text="SteamGridDB" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,6"/>
                <TextBlock Text="Busca a melhor arte disponível para o jogo e salva uma cópia local no LUDARYX." Foreground="#9BA3B4" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="BUSCAR CAPA VERTICAL" Click="DownloadSteamGridVertical_Click" Margin="0,0,8,0"/>
                    <Button Content="BUSCAR ARTE HORIZONTAL" Click="DownloadSteamGridHorizontal_Click"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="ESCOLHER CAPA VERTICAL" Click="ChooseSteamGridVertical_Click" Margin="0,0,8,0"/>
                    <Button Content="ESCOLHER ARTE HORIZONTAL" Click="ChooseSteamGridHorizontal_Click"/>
                </WrapPanel>
                <Button Content="CORRIGIR JOGO DO STEAMGRIDDB" Click="CorrectSteamGridGame_Click" Margin="0,0,0,18" HorizontalAlignment="Left" ToolTip="Escolha manualmente qual jogo do SteamGridDB corresponde a este jogo."/>
                <Button Content="SALVAR CLASSIFICAÇÃO MANUAL" Click="SaveMetadata_Click" Margin="0,10,0,20" HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Grid.ColumnSpan="2" Content="FECHAR" Width="110" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
