<Window x:Class="UnifiedGameLauncher.SteamGridDbGamePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher jogo no SteamGridDB" Width="760" Height="620"
        WindowStartupLocation="CenterOwner" Background="#0D0F14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ESCOLHER JOGO DO STEAMGRIDDB" Foreground="White" FontSize="24" FontWeight="Bold"/>
        <DockPanel Grid.Row="1" Margin="0,14,0,12">
            <Button DockPanel.Dock="Right" Content="PESQUISAR" Width="120" Click="Search_Click"/>
            <TextBox x:Name="SearchBox" Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="ResultsList" Grid.Row="2" Background="#151923" BorderThickness="0" Foreground="White" MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1A1F2A" CornerRadius="8" Padding="12" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding Id, StringFormat=ID: {0}}" Foreground="#9BA3B4" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="VERIFICADO" Foreground="#7FC8FF" VerticalAlignment="Center" Visibility="{Binding Verified, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="CANCELAR" Width="110" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="USAR SELECIONADO" Width="150" Click="Use_Click"/>
        </StackPanel>
    </Grid>
</Window>
