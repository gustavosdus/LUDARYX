<Window x:Class="UnifiedGameLauncher.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Estatísticas" Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource LudaryxWindowBackground}"
        Foreground="{DynamicResource LudaryxTextPrimary}"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource LudaryxTitleBarBackground}"
                BorderBrush="{DynamicResource LudaryxTitleBarBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource LudaryxRed}" Margin="0,0,9,0"/>
                    <TextBlock Text="LUDARYX"
                               Foreground="{DynamicResource LudaryxTextPrimary}"
                               FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="  /  Estatísticas"
                               Foreground="{DynamicResource LudaryxTitleBarSecondaryText}"
                               FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="—" Click="MinimizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="□" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="×" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ESTATÍSTICAS LOCAIS" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="26" FontWeight="Bold"/>
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource LudaryxTextSecondary}" Margin="0,6,0,18" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer x:Name="StatsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Mais jogados" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <ItemsControl x:Name="MostPlayedList" Margin="0,8,0,18">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource LudaryxTextPrimary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PlayCountDisplay}" Foreground="{DynamicResource LudaryxTextSecondary}"/>
                                <TextBlock Grid.Column="2" Text="{Binding TotalPlayTimeDisplay}" Foreground="{DynamicResource LudaryxTextSecondary}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Uso por plataforma" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <ItemsControl x:Name="PlatformStatsList" Margin="0,8,0,18">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource LudaryxTextPrimary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Launches}" Foreground="{DynamicResource LudaryxTextSecondary}"/>
                                <TextBlock Grid.Column="2" Text="{Binding PlayTime}" Foreground="{DynamicResource LudaryxTextSecondary}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Tempo jogado por mês" Foreground="{DynamicResource LudaryxTextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                <ItemsControl x:Name="MonthlyStatsList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Month}" Foreground="{DynamicResource LudaryxTextPrimary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PlayTime}" Foreground="{DynamicResource LudaryxTextSecondary}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="CloseButton" Grid.Row="2" Content="FECHAR" Width="110" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>