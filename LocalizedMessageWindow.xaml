<Window x:Class="UnifiedGameLauncher.LocalizedMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUDARYX"
        Width="480"
        SizeToContent="Height"
        MinHeight="190"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource LudaryxWindowBackground}">
    <Border BorderBrush="{DynamicResource LudaryxBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource LudaryxPanelBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource LudaryxTitleBarBackground}"
                    BorderBrush="{DynamicResource LudaryxTitleBarBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <TextBlock Text="LUDARYX"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource LudaryxTextPrimary}"
                               FontWeight="Bold"
                               FontSize="12"/>
                    <Button HorizontalAlignment="Right"
                            Width="34"
                            Style="{StaticResource LudaryxWindowButton}"
                            Content="×"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="MessageText"
                           Grid.Row="0"
                           Foreground="{DynamicResource LudaryxTextPrimary}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="20"/>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">
                    <Button x:Name="SecondaryButton"
                            Width="108"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="Secondary_Click"/>
                    <Button x:Name="PrimaryButton"
                            Width="108"
                            Click="Primary_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>