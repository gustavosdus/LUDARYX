<Window x:Class="UnifiedGameLauncher.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Atualização do LUDARYX"
        Width="540" Height="235"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource LudaryxWindowBackground}"
        Foreground="{DynamicResource LudaryxTextPrimary}"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource LudaryxTitleBarBackground}"
                BorderBrush="{DynamicResource LudaryxTitleBarBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource LudaryxRed}" Margin="0,0,9,0"/>
                    <TextBlock Text="LUDARYX" Foreground="{DynamicResource LudaryxTextPrimary}"
                               FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="  /  Atualização"
                               Foreground="{DynamicResource LudaryxTitleBarSecondaryText}"
                               FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="—" Click="MinimizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="×" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Baixando atualização"
                   Foreground="{DynamicResource LudaryxTextPrimary}"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Preparando download..."
                   Foreground="{DynamicResource LudaryxTextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,14"/>

        <ProgressBar x:Name="DownloadProgressBar"
                     Grid.Row="2"
                     Height="16"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="True"/>

        <Grid Grid.Row="3"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressText"
                       Grid.Column="0"
                       Foreground="{DynamicResource LudaryxTextSecondary}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,16,0"/>
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="CANCELAR"
                    Width="110"
                    MinHeight="36"
                    VerticalAlignment="Center"
                    Click="Cancel_Click"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
