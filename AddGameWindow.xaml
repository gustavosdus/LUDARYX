<Window x:Class="UnifiedGameLauncher.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar jogo" Width="620" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0D1119">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ADICIONAR JOGO MANUALMENTE" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Nome" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <TextBox x:Name="NameBox" Height="36" Padding="8"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Executável (.exe)" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <DockPanel>
                <Button Content="PROCURAR" Width="95" DockPanel.Dock="Right" Click="BrowseExe_Click"/>
                <TextBox x:Name="ExeBox" Height="36" Padding="8"/>
            </DockPanel>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Argumentos de inicialização (opcional)" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <TextBox x:Name="ArgumentsBox" Height="36" Padding="8"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="URI de inicialização (opcional)" Foreground="#AEB7C8" Margin="0,0,0,5"/>
            <TextBox x:Name="UriBox" Height="36" Padding="8"/>
        </StackPanel>
        <TextBlock Grid.Row="5" Text="Preencha o executável ou uma URI. A URI é útil para jogos que usam um launcher específico." Foreground="#7F8AA3" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="CANCELAR" Width="110" Margin="4" Click="Cancel_Click"/>
            <Button Content="ADICIONAR" Width="120" Margin="4" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
