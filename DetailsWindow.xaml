<Window x:Class="UnifiedGameLauncher.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Detalhes do jogo"
        Width="1180" Height="780"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource LudaryxWindowBackground}"
        Foreground="{StaticResource LudaryxTextPrimary}"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#070A10"
                BorderBrush="#1A2635" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource LudaryxRed}" Margin="0,0,9,0"/>
                    <TextBlock Text="LUDARYX" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="  /  Detalhes do jogo" Foreground="#7F91A8" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="—" Click="MinimizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="□" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource LudaryxWindowButton}" Content="×" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Artwork column -->
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="CAPA VERTICAL" Style="{StaticResource LudaryxLabel}"/>
                <Border Style="{StaticResource LudaryxCard}" Padding="5" Height="405">
                    <Image x:Name="VerticalCoverImage" Stretch="Uniform"/>
                </Border>

                <TextBlock Text="CAPA HORIZONTAL" Style="{StaticResource LudaryxLabel}" Margin="0,14,0,5"/>
                <Border Style="{StaticResource LudaryxCard}" Padding="5" Height="128">
                    <Image x:Name="HorizontalCoverImage" Stretch="Uniform"/>
                </Border>
            </StackPanel>

            <!-- Details content -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,4,0"
                          CanContentScroll="False">
                <StackPanel Margin="0,0,10,18">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="31" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PlatformText" Foreground="{StaticResource LudaryxTextSecondary}" FontSize="13" Margin="0,5,0,8"/>

                    <Border x:Name="DuplicatePrimaryBadge"
                            Background="#102638" BorderBrush="#285D7D" BorderThickness="1"
                            CornerRadius="6" Padding="9,5" HorizontalAlignment="Left"
                            Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="DuplicatePrimaryBadgeText" Foreground="#77D6FF" FontSize="11" FontWeight="SemiBold"/>
                    </Border>

                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="FavoriteButton" Content="☆ FAVORITO" Click="Favorite_Click" Margin="0,0,7,7"/>
                        <Button Content="JOGAR" Style="{StaticResource LudaryxPrimaryButton}" Click="Play_Click" Margin="0,0,7,7"/>
                        <Button Content="OCULTAR" Click="Hide_Click" Margin="0,0,7,7"/>
                        <Button Content="EXCLUIR DA BIBLIOTECA" Style="{StaticResource LudaryxDangerButton}" Click="Exclude_Click" Margin="0,0,7,7"/>
                        <Button x:Name="EditManualLaunchButton" Content="EDITAR INICIALIZAÇÃO" Click="EditManualLaunch_Click" Visibility="Collapsed" Margin="0,0,7,7"/>
                        <Button x:Name="DuplicateManualGameButton" Content="DUPLICAR ENTRADA" Click="DuplicateManualGame_Click" Visibility="Collapsed" Margin="0,0,7,7"/>
                        <Button x:Name="OpenInstallFolderButton" Content="ABRIR PASTA DO JOGO" Click="OpenInstallFolder_Click" Margin="0,0,7,7"/>
                        <Button Content="ATUALIZAR METADADOS" Click="RefreshMetadata_Click" Margin="0,0,7,7"/>
                        <Button x:Name="MakePrimaryDuplicateButton" Content="TORNAR ESTA VERSÃO PRINCIPAL" Click="MakePrimaryDuplicate_Click" Visibility="Collapsed" Margin="0,0,7,7"/>
                    </WrapPanel>

                    <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="Gêneros" Style="{StaticResource LudaryxLabel}"/>
                                <TextBlock x:Name="GenreText" Foreground="White" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <TextBlock Text="Desenvolvedor / Publicadora" Style="{StaticResource LudaryxLabel}"/>
                                <TextBlock x:Name="CompanyText" Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                <TextBlock Text="Lançamento" Style="{StaticResource LudaryxLabel}"/>
                                <TextBlock x:Name="ReleaseText" Foreground="White" Margin="0,0,0,14"/>
                                <TextBlock Text="Classificação indicativa" Style="{StaticResource LudaryxLabel}"/>
                                <TextBlock x:Name="AgeRatingText" Foreground="White"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Uso local" Style="{StaticResource LudaryxLabel}"/>
                                <TextBlock x:Name="UsageText" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <TextBlock Text="Instalação" Style="{StaticResource LudaryxLabel}"/>
                                <TextBlock x:Name="InstallPathText" Foreground="White" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock x:Name="RunningText" Grid.ColumnSpan="3"
                                       Foreground="{StaticResource LudaryxBlue}" FontWeight="SemiBold"
                                       VerticalAlignment="Bottom" Margin="0,78,0,0"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10"
                            Visibility="{Binding Visibility, ElementName=DuplicateText}">
                        <TextBlock x:Name="DuplicateText" Foreground="#E6C577" TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Descrição" Style="{StaticResource LudaryxSectionTitle}"/>
                            <TextBlock x:Name="DescriptionText" Foreground="#D4DCE7" TextWrapping="Wrap" LineHeight="21"/>
                            <TextBlock x:Name="MetadataSourceText" Foreground="#6F829A" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LudaryxCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Classificação manual" Style="{StaticResource LudaryxSectionTitle}" Margin="0,0,0,2"/>
                            <TextBlock Text="Edite informações locais sem alterar os arquivos originais do jogo."
                                       Foreground="{StaticResource LudaryxTextSecondary}" FontSize="11" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="Nome do jogo" Style="{StaticResource LudaryxLabel}"/>
                                    <TextBox x:Name="ManualNameBox" ToolTip="Nome"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,10">
                                    <TextBlock Text="Gêneros" Style="{StaticResource LudaryxLabel}"/>
                                    <TextBox x:Name="ManualGenresBox" ToolTip="Gêneros separados por vírgula"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Desenvolvedor" Style="{StaticResource LudaryxLabel}"/>
                                    <TextBox x:Name="ManualDeveloperBox" ToolTip="Desenvolvedor"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="Publicadora" Style="{StaticResource LudaryxLabel}"/>
                                    <TextBox x:Name="ManualPublisherBox" ToolTip="Publicadora"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,10">
                                    <TextBlock Text="Ano de lançamento" Style="{StaticResource LudaryxLabel}"/>
                                    <TextBox x:Name="ManualReleaseYearBox" ToolTip="Ano de lançamento"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Classificação indicativa" Style="{StaticResource LudaryxLabel}"/>
                                    <TextBox x:Name="ManualAgeRatingBox" ToolTip="Classificação indicativa do sistema correspondente ao idioma atual"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                    <TextBlock Text="Descrição" Style="{StaticResource LudaryxLabel}"/>
                                    <TextBox x:Name="ManualDescriptionBox" Height="96" TextWrapping="Wrap"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="Descrição"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource LudaryxCard}" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="Artes personalizadas" Style="{StaticResource LudaryxSectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock Text="As imagens escolhidas são copiadas para a pasta do LUDARYX."
                                           Foreground="{StaticResource LudaryxTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Content="ESCOLHER CAPA VERTICAL" Click="ChooseVerticalArtwork_Click" Margin="0,0,0,6"/>
                                <Button Content="RESTAURAR VERTICAL" Click="RestoreVerticalArtwork_Click" Margin="0,0,0,6"/>
                                <Button Content="ESCOLHER ARTE HORIZONTAL" Click="ChooseHorizontalArtwork_Click" Margin="0,0,0,6"/>
                                <Button Content="RESTAURAR HORIZONTAL" Click="RestoreHorizontalArtwork_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource LudaryxCard}" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="SteamGridDB" Style="{StaticResource LudaryxSectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock Text="Busque e selecione artes para este jogo."
                                           Foreground="{StaticResource LudaryxTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Content="BUSCAR CAPA VERTICAL" Click="DownloadSteamGridVertical_Click" Margin="0,0,0,6"/>
                                <Button Content="BUSCAR ARTE HORIZONTAL" Click="DownloadSteamGridHorizontal_Click" Margin="0,0,0,6"/>
                                <Button Content="ESCOLHER CAPA VERTICAL" Click="ChooseSteamGridVertical_Click" Margin="0,0,0,6"/>
                                <Button Content="ESCOLHER ARTE HORIZONTAL" Click="ChooseSteamGridHorizontal_Click" Margin="0,0,0,6"/>
                                <Button Content="CORRIGIR JOGO DO STEAMGRIDDB" Click="CorrectSteamGridGame_Click"
                                        ToolTip="Escolha manualmente qual jogo do SteamGridDB corresponde a este jogo."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#080C13" BorderBrush="#1B2A3B" BorderThickness="0,1,0,0">
            <Grid Margin="24,9">
                <Button Content="FECHAR" Width="120" HorizontalAlignment="Left" Click="Close_Click"/>
                <Button Content="SALVAR CLASSIFICAÇÃO MANUAL" Width="230"
                        HorizontalAlignment="Right" Style="{StaticResource LudaryxPrimaryButton}" Click="SaveMetadata_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>