<Window x:Class="UnifiedGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:services="clr-namespace:UnifiedGameLauncher.Services"
        Title="LUDARYX" Icon="pack://application:,,,/Assets/LUDARYX.ico" Width="1400" Height="900"
        WindowStartupLocation="CenterScreen" Background="#05070B"
        WindowStyle="None" ResizeMode="CanResize"
        MinWidth="800" MinHeight="500"
        KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <services:CoverImageConverter x:Key="CoverImageConverter"/>

        <!-- Paleta principal -->
        <SolidColorBrush x:Key="BlackChrome" Color="#050507"/>
        <SolidColorBrush x:Key="BlackPanel" Color="#090A0D"/>
        <SolidColorBrush x:Key="GameAreaBlue" Color="#07182D"/>
        <SolidColorBrush x:Key="NeonRed" Color="#FF163D"/>
        <SolidColorBrush x:Key="NeonBlue" Color="#66F5FF"/>
        <SolidColorBrush x:Key="SelectionAccentBorder" Color="#66F5FF"/>
        <SolidColorBrush x:Key="SelectionAccentGameFill" Color="#13DFFF"/>

        <!-- Recursos que mudam com o tema. Mantidos centralizados para facilitar edição manual. -->
        <SolidColorBrush x:Key="ToolbarFieldBackground" Color="#050507"/>
        <SolidColorBrush x:Key="SearchFieldBackground" Color="#11151D"/>
        <SolidColorBrush x:Key="NavButtonBackground" Color="#11151D"/>
        <SolidColorBrush x:Key="NavButtonHoverBackground" Color="#1A202B"/>
        <SolidColorBrush x:Key="NavButtonPressedBackground" Color="#252D3A"/>
        <SolidColorBrush x:Key="ToolbarFieldHoverBackground" Color="#0A0D12"/>
        <SolidColorBrush x:Key="ToolbarPopupBackground" Color="#050507"/>
        <SolidColorBrush x:Key="ToolbarItemHoverBackground" Color="#111A26"/>
        <SolidColorBrush x:Key="ToolbarItemSelectedBackground" Color="#10283D"/>
        <SolidColorBrush x:Key="SearchCaretBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8E98AA"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#202938"/>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE2EC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20242D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource NavButtonBackground}"/>
            <Setter Property="Foreground" Value="#E8ECF5"/>
            <Setter Property="BorderBrush" Value="#293242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.58"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavButtonHoverBackground}"/>
                                <Setter Property="BorderBrush" Value="#465166"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavButtonPressedBackground}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Botão de tela cheia sem fundo: somente o ícone do monitor -->
        <Style x:Key="FullscreenIconButton" TargetType="Button">
            <Setter Property="Opacity" Value="0.50"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox totalmente integrado ao tema; não usa o template cinza padrão do Windows -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="138"/>
            <Setter Property="Foreground" Value="#E8ECF5"/>
            <Setter Property="Background" Value="{DynamicResource ToolbarFieldBackground}"/>
            <Setter Property="BorderBrush" Value="#252D3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="9,0,3,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False"/>
                                <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2"
                                              Background="Transparent" BorderThickness="0"
                                              Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" Width="8" Height="5"
                                                      Fill="#9AA6B8" Stretch="Fill"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,3,0,0" Padding="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="330" Background="{DynamicResource ToolbarPopupBackground}"
                                        BorderBrush="#252D3A" BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#3A465A"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource ToolbarFieldHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8ECF5"/>
            <Setter Property="Background" Value="{DynamicResource ToolbarPopupBackground}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ToolbarItemHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ToolbarItemSelectedBackground}"/>
                                <Setter Property="Foreground" Value="#62D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de rolagem integrada ao tema -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#354660"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1,3,1,3">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Background="Transparent" BorderThickness="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="44" Background="#354660" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#354660" CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Background="Transparent" BorderThickness="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="StartupStoryboard">
            <!-- Animação de abertura com a logo transparente LUDARYX. -->
            <DoubleAnimation Storyboard.TargetName="StartupLogoHost" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.70"/>
            <DoubleAnimation Storyboard.TargetName="StartupLogoScale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1" BeginTime="0:0:0.15" Duration="0:0:0.70"/>
            <DoubleAnimation Storyboard.TargetName="StartupLogoScale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1" BeginTime="0:0:0.15" Duration="0:0:0.70"/>
            <DoubleAnimation Storyboard.TargetName="StartupGlowHalo" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.34" BeginTime="0:0:0.28" Duration="0:0:0.75"/>
            <DoubleAnimation Storyboard.TargetName="StartupAccentLine" Storyboard.TargetProperty="Width"
                             From="0" To="760" BeginTime="0:0:0.95" Duration="0:0:0.55"/>
            <DoubleAnimation Storyboard.TargetName="StartupAccentLine" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.95" Duration="0:0:0.12"/>

            <!-- Pulso principal por volta de 3,5 s. -->
            <DoubleAnimation Storyboard.TargetName="StartupLogoScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.025" AutoReverse="True" BeginTime="0:0:3.35" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="StartupLogoScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.025" AutoReverse="True" BeginTime="0:0:3.35" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="StartupGlowHalo" Storyboard.TargetProperty="Opacity"
                             From="0.34" To="0.48" AutoReverse="True" BeginTime="0:0:3.35" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="StartupAccentLine" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.60" AutoReverse="True" BeginTime="0:0:3.40" Duration="0:0:0.18"/>

            <!-- Fade-out para a biblioteca. -->
            <DoubleAnimation Storyboard.TargetName="StartupOverlay" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" BeginTime="0:0:4.5" Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="MainRoot" Background="{StaticResource BlackChrome}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="112"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho preto integrado -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Background="{StaticResource BlackChrome}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pesquisa + quantidade no canto superior esquerdo -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0">
                <Border Width="290" Height="32" Background="{DynamicResource SearchFieldBackground}" BorderBrush="#293242" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <TextBlock Text="⌕" Foreground="#7E8798" FontSize="17" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="SearchBox" Margin="32,0,8,0"
                                 Background="Transparent" Foreground="#E8ECF5" CaretBrush="{DynamicResource SearchCaretBrush}" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 TextChanged="SearchBox_TextChanged" ToolTip="Pesquisar jogos"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="GameCountText" Text="0 jogos exibidos"
                           Foreground="{StaticResource TextSecondary}" FontSize="10"
                           Margin="4,4,0,0"/>
            </StackPanel>

            <!-- Logo centralizada da identidade LUDARYX. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/LUDARYX.png"
                       Width="250" Height="60"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       HorizontalAlignment="Center"/>
                <TextBlock x:Name="LibraryLoadingText"
                           Text="CARREGANDO BIBLIOTECA..."
                           Visibility="Collapsed"
                           Foreground="#E8ECF5"
                           FontSize="10" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"
                           Panel.ZIndex="20"/>
            </StackPanel>

            <!-- Tela cheia + controles da janela no canto superior direito -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                <Button Style="{StaticResource FullscreenIconButton}" Margin="0,0,8,0" Click="Fullscreen_Click" ToolTip="Tela cheia">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#E8ECF5" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Data="M3,4 L21,4 L21,17 L3,17 Z M9,21 L15,21 M12,17 L12,21"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Content="—" Style="{StaticResource WindowButton}" Click="MinimizeWindow_Click" ToolTip="Minimizar"/>
                <Button Content="□" Style="{StaticResource WindowButton}" Click="MaximizeWindow_Click" ToolTip="Maximizar"/>
                <Button Content="×" Style="{StaticResource WindowButton}" Click="CloseWindow_Click" ToolTip="Fechar"/>
            </StackPanel>
        </Grid>

        <!-- Separador neon -->
        <Border x:Name="NeonSeparator" Grid.Row="1" Background="{StaticResource NeonRed}"/>

        <!-- Filtros e ações compactos. No fullscreen a pesquisa entra nesta fileira
             e o botão de tela cheia fica ancorado no extremo direito. -->
        <Border x:Name="ToolbarBorder" Grid.Row="2" Background="{StaticResource BlackChrome}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="LibraryFilterCombo" Width="150" Style="{StaticResource FilterCombo}" ItemContainerStyle="{StaticResource FilterComboItem}" SelectionChanged="LibraryFilterCombo_SelectionChanged" ToolTip="Filtrar biblioteca">
                            <ComboBoxItem Content="TODOS" Tag="all"/>
                            <ComboBoxItem Content="FAVORITOS" Tag="favorites"/>
                            <ComboBoxItem Content="RECENTES" Tag="recent"/>
                            <ComboBoxItem Content="DUPLICADOS" Tag="duplicates"/>
                        </ComboBox>
                        <ComboBox x:Name="PlatformFilterCombo" Width="150" Style="{StaticResource FilterCombo}" ItemContainerStyle="{StaticResource FilterComboItem}" SelectionChanged="PlatformFilterCombo_SelectionChanged" ToolTip="Filtrar por plataforma">
                            <ComboBoxItem Content="TODAS PLATAFORMAS" Tag="all"/>
                            <ComboBoxItem Content="STEAM" Tag="Steam"/>
                            <ComboBoxItem Content="EPIC" Tag="Epic"/>
                            <ComboBoxItem Content="GOG" Tag="GOG"/>
                            <ComboBoxItem Content="XBOX / STORE" Tag="Xbox"/>
                            <ComboBoxItem Content="EA APP" Tag="EAApp"/>
                            <ComboBoxItem Content="UBISOFT" Tag="UbisoftConnect"/>
                            <ComboBoxItem Content="BATTLE.NET" Tag="BattleNet"/>
                            <ComboBoxItem Content="RIOT" Tag="RiotClient"/>
                            <ComboBoxItem Content="MANUAIS" Tag="Manual"/>
                        </ComboBox>
                        <ComboBox x:Name="GenreFilter" Width="156" Style="{StaticResource FilterCombo}" ItemContainerStyle="{StaticResource FilterComboItem}" SelectionChanged="GenreFilter_SelectionChanged" ToolTip="Filtrar por gênero"/>
                        <ComboBox x:Name="SortCombo" Width="145" Style="{StaticResource FilterCombo}" ItemContainerStyle="{StaticResource FilterComboItem}" SelectionChanged="SortCombo_SelectionChanged" ToolTip="Ordenar">
                            <ComboBoxItem Content="NOME" Tag="Name"/>
                            <ComboBoxItem Content="RECENTES" Tag="Recent"/>
                            <ComboBoxItem Content="MAIS JOGADOS" Tag="MostPlayed"/>
                            <ComboBoxItem Content="TEMPO JOGADO" Tag="PlayTime"/>
                            <ComboBoxItem Content="PLATAFORMA" Tag="Platform"/>
                        </ComboBox>
                        <Button x:Name="AddGameButton" Content="ADICIONAR JOGO" Style="{StaticResource NavButton}" Click="AddGame_Click"/>
                        <Button x:Name="RefreshButton" Content="ATUALIZAR" Style="{StaticResource NavButton}" Click="Refresh_Click"/>
                        <Button x:Name="SettingsButton" Content="CONFIGURAÇÕES" Style="{StaticResource NavButton}" Click="Settings_Click"/>
                        <Button x:Name="StatisticsButton" Content="ESTATÍSTICAS" Style="{StaticResource NavButton}" Click="Statistics_Click"/>

                        <Border x:Name="FullscreenSearchContainer" Visibility="Collapsed" Width="260" Height="32" Margin="7,0,3,0"
                                Background="{DynamicResource SearchFieldBackground}" BorderBrush="#293242" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <TextBlock Text="⌕" Foreground="#7E8798" FontSize="17" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox x:Name="FullscreenSearchBox" Margin="32,0,8,0" Background="Transparent" Foreground="#E8ECF5"
                                         CaretBrush="{DynamicResource SearchCaretBrush}" BorderThickness="0" VerticalContentAlignment="Center" FontSize="12"
                                         TextChanged="FullscreenSearchBox_TextChanged" ToolTip="Pesquisar jogos"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="FullscreenLibraryLoadingText"
                                   Text="CARREGANDO BIBLIOTECA..."
                                   Visibility="Collapsed"
                                   Foreground="#E8ECF5"
                                   FontSize="10" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,3,0"/>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="FullscreenToolbarButton" Grid.Column="1" Visibility="Collapsed"
                        Style="{StaticResource FullscreenIconButton}" Margin="8,0,16,0" Click="Fullscreen_Click" ToolTip="Sair da tela cheia">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#E8ECF5" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Data="M3,4 L21,4 L21,17 L3,17 Z M9,21 L15,21 M12,17 L12,21"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- Área dos jogos em azul escuro -->
        <Border x:Name="LibraryAreaBorder" Grid.Row="3" Background="{StaticResource GameAreaBlue}">
            <ScrollViewer x:Name="LibraryScroll" Padding="14,12,14,16">
                <ItemsControl x:Name="GameList" Focusable="True" FocusVisualStyle="{x:Null}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding CoverWidth}" Height="{Binding CoverHeight}" Margin="8"
                                    Background="#0B1423" BorderThickness="3" CornerRadius="8"
                                    MouseLeftButtonUp="Cover_Click" MouseRightButtonUp="Cover_RightClick"
                                    ToolTip="Clique esquerdo: jogar • clique direito: personalizar">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Background" Value="#0B1423"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsControllerSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SelectionAccentBorder}"/>
                                                <Setter Property="Background" Value="{DynamicResource SelectionAccentGameFill}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid ClipToBounds="True">
                                    <Image Source="{Binding DisplayCover, Converter={StaticResource CoverImageConverter}}" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,3" CornerRadius="5" Background="#CC0E7490">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="JOGANDO" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Rodapé: status à esquerda e dicas do método de entrada à direita. -->
        <Border x:Name="FooterBorder" Grid.Row="4" Background="{StaticResource BlackChrome}">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mantido apenas para o código de status interno. Não é exibido na interface. -->
                <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
                <TextBlock x:Name="ControllerStatusText" Grid.Column="0"
                           Text="Controle: procurando..."
                           Foreground="White" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Xbox: A verde para selecionar; B vermelho para personalizar. -->
                    <StackPanel x:Name="XboxFooterHints" Orientation="Horizontal" Visibility="Collapsed">
                        <Grid Width="22" Height="22" Margin="0,0,6,0">
                            <Ellipse Fill="#2FA84F"/>
                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="XboxSelectHintText" Text="SELECIONAR" Foreground="White"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>

                        <Grid Width="22" Height="22" Margin="20,0,6,0">
                            <Ellipse Fill="#D64545"/>
                            <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="XboxCustomizeHintText" Text="PERSONALIZAR" Foreground="White"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- PlayStation: X azul e círculo vermelho sobre base escura. -->
                    <StackPanel x:Name="PlayStationFooterHints" Orientation="Horizontal" Visibility="Collapsed">
                        <Grid Width="22" Height="22" Margin="0,0,6,0">
                            <Ellipse Fill="#20242D"/>
                            <TextBlock Text="X" Foreground="#4AA3FF" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="PlayStationSelectHintText" Text="SELECIONAR" Foreground="White"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>

                        <Grid Width="22" Height="22" Margin="20,0,6,0">
                            <Ellipse Fill="#20242D"/>
                            <Ellipse Width="10" Height="10" Stroke="#FF5B67" StrokeThickness="2" Fill="Transparent"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="PlayStationCustomizeHintText" Text="PERSONALIZAR" Foreground="White"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Teclado: keycaps representando Enter e Espaço. -->
                    <StackPanel x:Name="KeyboardFooterHints" Orientation="Horizontal">
                        <Border Width="48" Height="22" Margin="0,0,6,0" Background="#171A21"
                                BorderBrush="#DCE2EC" BorderThickness="1" CornerRadius="3">
                            <TextBlock Text="ENTER" Foreground="White" FontSize="8" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="KeyboardSelectHintText" Text="SELECIONAR" Foreground="White"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>

                        <Border Width="58" Height="22" Margin="20,0,6,0" Background="#171A21"
                                BorderBrush="#DCE2EC" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <TextBlock Text="SPACE" Foreground="White" FontSize="8" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Height="2" Width="34" Background="#DCE2EC"
                                        VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="KeyboardCustomizeHintText" Text="PERSONALIZAR" Foreground="White"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Animação de inicialização com a logo transparente LUDARYX.
             Permanece por aproximadamente 5 segundos acima da interface. -->
        <Grid x:Name="StartupOverlay" Grid.RowSpan="5" Panel.ZIndex="9999"
              Background="#02050C" Opacity="1" IsHitTestVisible="True">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1240" Height="380">
                <Ellipse x:Name="StartupGlowHalo" Width="900" Height="150" Fill="#1AAEFF" Opacity="0"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,42,0,0">
                    <Ellipse.Effect>
                        <BlurEffect Radius="80"/>
                    </Ellipse.Effect>
                </Ellipse>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid x:Name="StartupLogoHost" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="StartupLogoScale" ScaleX="0.92" ScaleY="0.92"/>
                        </Grid.RenderTransform>
                        <Image Source="pack://application:,,,/Assets/LUDARYX.png"
                               Width="940"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               HorizontalAlignment="Center"/>
                    </Grid>

                    <Rectangle x:Name="StartupAccentLine"
                               Width="0" Height="3" Opacity="0"
                               Fill="#2AB0FF" RadiusX="2" RadiusY="2"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>

                    <TextBlock x:Name="StartupLibraryLoadingText"
                               Text="CARREGANDO BIBLIOTECA..."
                               Visibility="Collapsed"
                               Foreground="#DCE9FF"
                               FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"
                               Panel.ZIndex="10000"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
